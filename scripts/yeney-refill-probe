SCRIPTS = Path(__file__).resolve().parent
ROOT = SCRIPTS.parent
spec = importlib.util.spec_from_file_location('timing', SCRIPTS / 'sonos-timing-probe.py')
timing = importlib.util.module_from_spec(spec)
spec.loader.exec_module(timing)

CASES = {
    'wav': ('wav', 'wav'),
    'fixed16': ('fixed16', 'fixed16'),
    'fixed24': ('fixed24', 'fixed24'),
    'packed16': ('packed16', 'packed16'),
    'packed24': ('packed24', 'packed24'),
    'fixed-then-packed': ('fixed16', 'packed16'),
    'packed-then-fixed': ('packed16', 'fixed16'),
    'fixed16-noseek': ('fixed16-noseek', 'fixed16-noseek'),
    'short': ('short-wav',) * 3,
    'short-fixed16': ('short-fixed16',) * 3,
    'bound': ('packed16', 'packed16'),
}

SERVICES = {'AVTransport': '/MediaRenderer/AVTransport',
            'RenderingControl': '/MediaRenderer/RenderingControl',
            'Queue': '/MediaRenderer/Queue',
            'ZoneGroupTopology': '/ZoneGroupTopology'}
DESCRIPTION_PATH = '/xml/device_description.xml'
ACTIONS = {'AVTransport': {'GetTransportInfo', 'GetMediaInfo', 'GetPositionInfo',
                           'GetTransportSettings', 'GetCrossfadeMode', 'AddURIToQueue',
                           'RemoveTrackRangeFromQueue', 'SetAVTransportURI', 'Seek',
                           'Play', 'Pause', 'Stop'},
           'RenderingControl': {'GetVolume'},
           'Queue': {'Browse'},
           'ZoneGroupTopology': {'GetZoneGroupState'}}

VERSION = '2'


def service_type(service):
    authority = 'sonos-com' if service == 'Queue' else 'upnp-org'
    return f'urn:schemas-{authority}:service:{service}:1'


def control_path(service):
    return SERVICES[service] + '/Control'


def local(tag):
    return tag.rsplit('}', 1)[-1]


def fields(xml):
    return {local(node.tag): node.text or '' for node in ET.fromstring(xml).iter()}


def position(value):
    try:
        hours, minutes, seconds = map(float, value.strip().split(':'))
        result = hours * 3600 + minutes * 60 + seconds
        return result if math.isfinite(result) and result >= 0 else None
    except (AttributeError, ValueError):
        return None


def hms(seconds):
    s = int(seconds)
    return f'{s // 3600:02}:{s // 60 % 60:02}:{s % 60:02}'


def wav_header(rate, frames):
    size = frames * 6
    if size + 36 > 0xffffffff:
        raise ValueError('track exceeds the RIFF size limit')
    return struct.pack('<4sI8sIHHIIHH4sI', b'RIFF', size + 36, b'WAVEfmt ',
                       16, 1, 2, rate, rate * 6, 6, 24, b'data', size)


def source_audio(source, pcm, helper, minimum):
    with source.open('rb') as stream:
        header = stream.read(8)
        if header[:4] != b'fLaC':
            raise ValueError('track is not a FLAC file')
        if len(header) != 8 or header[4] & 0x7f or header[5:] != b'\x00\x00\x22':
            raise ValueError('track has invalid FLAC STREAMINFO')
        info = stream.read(34)
    if len(info) != 34:
        raise ValueError('track has incomplete FLAC STREAMINFO')
    data = int.from_bytes(info[10:18], 'big')
    rate, frames = data >> 44, data & ((1 << 36) - 1)
    if not rate or not frames:
        raise ValueError('FLAC track does not declare its duration')
    if frames / rate < minimum:
        raise ValueError(f'FLAC track is too short ({frames / rate:.1f} s, need {minimum} s)')
    channels, bits = ((data >> 41) & 7) + 1, ((data >> 36) & 31) + 1
    if channels > 2 or bits > 24:
        raise ValueError('need a mono or stereo FLAC track with at most 24 bits per sample')
    if pcm.exists():
        pcm.unlink()
    audio_command(helper, source, pcm)
    if pcm.stat().st_size != frames * 6:
        raise ValueError('FLAC decode failed or its sample count differs from STREAMINFO')
    return rate, frames, bits, channels


def audio_command(helper, *args):
    result = subprocess.run([helper, *map(str, args)], capture_output=True, text=True)
    if result.returncode:
        raise ValueError('audio preparation failed: ' + (result.stderr.strip() or str(args[0])))
    return result.stdout


def audio_helper(work):
    helper = work / 'refill-audio'
    if not helper.exists():
        recipe = ('refill-audio: ' + str(SCRIPTS / 'yeney-refill-audio.cpp') +
                  '\n\t$(CXX) -std=c++17 -O2 -Wall -Wextra $< -lFLAC -o $@\n')
        subprocess.run(['make', '-s', '-f', '-', 'refill-audio'], cwd=work, input=recipe,
                       text=True, check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    return helper


def written_pcm(source, target, width, frames, channels):
    remaining = frames * 6
    pattern = random.Random(717)
    with source.open('rb') as stream, target.open('wb') as output:
        while remaining:
            chunk = bytearray(stream.read(min(remaining, 6 * 8192)))
            if not chunk or len(chunk) % 6:
                raise ValueError('short PCM source while preparing row')
            remaining -= len(chunk)
            if channels == 1:
                mono = bytearray(len(chunk) // 2)
                mono[0::3], mono[1::3], mono[2::3] = chunk[0::6], chunk[1::6], chunk[2::6]
                chunk = mono
            if width == 2:
                body = bytearray(len(chunk) * 2 // 3)
                body[0::2], body[1::2] = chunk[1::3], chunk[2::3]
            else:
                # Preserve the source's high 16 bits. The largest added
                # magnitude, 15 in 24-bit PCM, is below -114 dBFS.
                low_bits = pattern.randbytes(len(chunk) // 3)
                chunk[0::3] = low_bits.translate(bytes(n & 15 for n in range(256)))
                body = chunk
            output.write(body)


def verify_pcm(source, width, channels, target, first_frame, frames):
    if target.stat().st_size != frames * 6:
        raise ValueError('FLAC decoded sample count differs from its PCM source')
    remaining = frames
    with source.open('rb') as pcm, target.open('rb') as decoded:
        pcm.seek(first_frame * channels * width)
        while remaining:
            count = min(remaining, 8192)
            remaining -= count
            expect = pcm.read(count * channels * width)
            if channels == 1:
                stereo = bytearray(count * 2 * width)
                for byte in range(width):
                    stereo[byte::2 * width] = stereo[byte + width::2 * width] = expect[byte::width]
                expect = stereo
            actual = decoded.read(count * 6)
            if width == 2:
                if (actual[0::3] != bytes(count * 2) or
                    actual[1::3] != expect[0::2] or actual[2::3] != expect[1::2]):
                    raise ValueError('FLAC verification changed source PCM')
            elif actual != expect:
                raise ValueError('FLAC verification changed source PCM')


def verify_seek_table(media, frames, offsets, expected):
    points = []
    with media.open('rb') as stream:
        if stream.read(4) != b'fLaC':
            raise ValueError('audio item is missing the FLAC marker')
        last = False
        while not last:
            header = stream.read(4)
            if len(header) != 4:
                raise ValueError('short FLAC metadata header')
            last = bool(header[0] & 0x80)
            kind = header[0] & 0x7f
            size = int.from_bytes(header[1:], 'big')
            if kind == 3:
                points = [(sample, offset, count) for sample, offset, count in
                          struct.iter_unpack('>QQH', stream.read(size)) if sample < frames]
            else:
                stream.seek(size, os.SEEK_CUR)
        first = stream.tell()
    actual = {(sample, offset - first, count) for sample, offset, count in offsets}
    if bool(points) != expected or any(point not in actual for point in points):
        raise ValueError('FLAC seek table disagrees with the delivered frame offsets')
    return len(points)


def verify_flac(helper, media, pcm, width, channels, frames, work, proof, seek_table):
    decoded = work / 'proof.pcm'
    with contextlib.suppress(FileNotFoundError):
        decoded.unlink()
    try:
        offsets = [tuple(map(int, row.split())) for row in
                   audio_command(helper, media, decoded).splitlines()]
        verify_pcm(pcm, width, channels, decoded, 0, frames)
    finally:
        decoded.unlink(missing_ok=True)
    points = verify_seek_table(media, frames, offsets, seek_table)
    if proof:
        predicted, sample, offset, largest = proof
        actual = media.stat().st_size
        if predicted != actual or (sample, offset) not in {(s, o) for s, o, _ in offsets}:
            raise ValueError('fixed FLAC predicted size or frame offset disagrees with decoded file')
        tail = work / 'proof-tail.flac'
        try:
            with media.open('rb') as full, tail.open('wb') as part:
                info = bytearray(full.read(42))
                info[4] |= 0x80
                part.write(info)
                full.seek(offset)
                shutil.copyfileobj(full, part)
            audio_command(helper, tail, decoded)
            verify_pcm(pcm, width, channels, decoded, sample, frames - sample)
        finally:
            tail.unlink(missing_ok=True)
            decoded.unlink(missing_ok=True)
        evidence = dict(predicted=predicted, written=actual, decoded_bit_exact=True,
                        range_sample=sample, range_offset=offset, range_bit_exact=True,
                        largest_frame=largest, seek_points=points)
    else:
        evidence = dict(decoded_bit_exact=True, seek_points=points)
    return [(s, o) for s, o, _ in offsets], evidence


def prepare_audio(source, work, cases, minimum):
    helper = audio_helper(work)
    original = work / 'source.pcm'
    rate, total_frames, source_bits, source_channels = source_audio(source, original, helper, minimum)
    forms = {form for case in cases for form in CASES[case]}
    if any('16' in form for form in forms) and source_bits != 16:
        raise ValueError(f'16-bit cases require a 16-bit FLAC source (track is {source_bits}-bit)')
    pcm_files = {}
    media = {}
    for form in sorted(forms):
        short = form.startswith('short-')
        size = 30 * rate if short else total_frames
        bits = 16 if '16' in form else 24
        width = bits // 8
        if size > total_frames:
            raise ValueError('need at least 30 seconds of source audio for short rows')
        is_wav = form.removeprefix('short-') == 'wav'
        channels = 2 if is_wav else source_channels
        pcm = pcm_files.get((size, bits, channels))
        if pcm is None:
            pcm = work / f'pcm-{size}-{bits}-{channels}'
            written_pcm(original, pcm, width, size, channels)
            pcm_files[size, bits, channels] = pcm
        index = []
        evidence = {}
        path = work / (form + ('.wav' if is_wav else '.flac'))
        if is_wav:
            with path.open('wb') as output, pcm.open('rb') as stream:
                output.write(wav_header(rate, size))
                shutil.copyfileobj(stream, output)
        else:
            proof = None
            mode = 'packed'
            if 'fixed' in form:
                mode = 'fixed-noseek' if 'noseek' in form else 'fixed'
            result = audio_command(helper, mode, pcm, path, size, rate, bits, channels)
            if mode != 'packed':
                proof = tuple(map(int, result.split()))
            index, evidence = verify_flac(helper, path, pcm, width, channels, size, work, proof, mode != 'fixed-noseek')
        media[form] = dict(path=path, frames=size, rate=rate, bits=bits, channels=channels, index=index, proof=evidence)
    return media


class Item:
    def __init__(self, path, duration, bound=None, index=(), frames=0):
        self.path = path
        self.actual = path.stat().st_size
        if bound is not None and bound <= self.actual:
            raise ValueError('packed FLAC item is not smaller than its advertised upper bound')
        self.length = self.actual if bound is None else bound
        self.duration = duration
        self.samples = [sample for sample, _ in index]
        self.offsets = [offset for _, offset in index]
        self.frames = frames
        header = 44 if path.suffix == '.wav' else 0
        self.play_rate = (self.actual - header) / self.duration
        self.burst = 2 * self.play_rate

    def paced(self, offset):
        if self.path.suffix == '.wav':
            seconds = max(0, offset - 44) / self.play_rate
        elif offset >= self.actual:
            return False
        else:
            index = max(0, bisect.bisect_right(self.offsets, offset) - 1)
            seconds = self.samples[index] * self.duration / self.frames
        return self.duration - seconds > 20

    def range(self, value):
        if not value:
            return 200, 0, self.length - 1
        match = re.fullmatch(r'bytes=([0-9]*)-([0-9]*)', value.strip())
        if not match:
            raise ValueError('unsupported Range')
        a, b = match.groups()
        if not a and (not b or int(b) == 0):
            raise ValueError('empty Range')
        first = int(a) if a else max(0, self.length - int(b))
        last = min(int(b), self.length - 1) if a and b else self.length - 1
        if first > last:
            raise ValueError('unsatisfiable Range')
        return 206, first, last


class Budget:
    def __init__(self, item):
        self.available = self.cap = item.burst
        self.refill = item.play_rate * 2
        self.last = time.monotonic()
        self.waited = 0

    def take(self, count, connection, closing):
        while True:
            now = time.monotonic()
            self.available = min(self.cap, self.available + (now - self.last) * self.refill)
            self.last = now
            if self.available >= count:
                self.available -= count
                return True
            if select.select([connection], [], [], 0)[0]:
                try:
                    if not connection.recv(1, socket.MSG_PEEK | socket.MSG_DONTWAIT):
                        return False
                except BlockingIOError:
                    pass
            stopped = closing.wait(min(.005, (count - self.available) / self.refill))
            self.waited += time.monotonic() - now
            if stopped:
                return False


class MediaServer(ThreadingHTTPServer):
    daemon_threads = True

    def __init__(self, host, records):
        super().__init__((host, 0), MediaHandler)
        self.items = {}
        self.records = records
        self.closing = threading.Event()


class MediaHandler(BaseHTTPRequestHandler):
    protocol_version = 'HTTP/1.1'

    def log_message(self, *_):
        pass

    def do_HEAD(self):
        self.serve(False)

    def do_GET(self):
        self.serve(True)

    def serve(self, body):
        item = self.server.items.get(self.path)
        if item is None:
            self.send_error(404)
            return
        self.connection.settimeout(3)
        self.close_connection = True
        request_range = self.headers.get('Range', '')
        event = dict(path=self.path, method=self.command, range=request_range)
        self.server.records.add('requests', event='open', **event)
        total = 0
        status = 416
        budget = None
        try:
            try:
                status, first, last = item.range(request_range)
            except ValueError:
                self.send_response_only(status, 'Range Not Satisfiable')
                self.send_header('Content-Range', f'bytes */{item.length}')
                self.send_header('Content-Length', '0')
                self.send_header('Connection', 'close')
                self.end_headers()
                return
            self.send_response_only(status)
            self.send_header('Content-Type', 'audio/flac' if item.path.suffix == '.flac' else 'audio/wav')
            self.send_header('Content-Length', str(last - first + 1))
            self.send_header('Accept-Ranges', 'bytes')
            self.send_header('Connection', 'close')
            if status == 206:
                self.send_header('Content-Range', f'bytes {first}-{last}/{item.length}')
            self.end_headers()
            if not body:
                return
            amount = min(last - first + 1, item.actual - first)
            budget = Budget(item) if item.paced(first) else None
            with item.path.open('rb') as stream:
                stream.seek(first)
                while total < amount and not self.server.closing.is_set():
                    count = min(8192, amount - total)
                    if budget:
                        count = min(count, int(budget.cap))
                        if not budget.take(count, self.connection, self.server.closing):
                            break
                    chunk = stream.read(count)
                    if not chunk:
                        break
                    self.wfile.write(chunk)
                    total += len(chunk)
                    self.server.records.add('bytes', path=self.path, size=len(chunk))
        except OSError as exc:
            self.server.records.add('requests', event='disconnect', detail=str(exc), **event)
        finally:
            self.server.records.add('requests', event='close', status=status, size=total,
                                    paced=int(budget is not None),
                                    pace_wait_ms=round(1000 * budget.waited) if budget else 0, **event)


class Records:
    def __init__(self):
        self.clock = time.monotonic()
        self.rows = []
        self.private = set()

    def add(self, kind, **data):
        if data.get('protocol') == 'websocket' and 'raw' in data:
            data['raw'] = self.speaker_data(data['raw'])
        self.rows.append(dict(time=time.monotonic() - self.clock, kind=kind, **data))

    def speaker_data(self, value):
        if isinstance(value, list):
            return [self.speaker_data(child) for child in value]
        if isinstance(value, dict):
            result = {}
            for key, child in value.items():
                if re.search(r'(household|group|player|device|location|coordinator|queue)Id|serialNumber|macAddress',
                             key, re.I):
                    result[key] = '<private>'
                else:
                    result[key] = self.speaker_data(child)
            return result
        return value

    def log(self, message):
        print(message, flush=True)
        self.add('log', message=message)

    def redact(self, value):
        for token in sorted(self.private, key=len, reverse=True):
            if token and not token.isdecimal():
                value = re.sub(r'(?<!\w)' + re.escape(token) + r'(?!\w)', '<private>', value)
        value = re.sub(r'(?i)\b(?:RINCON|Sonos)_[A-Za-z0-9_.-]+', '<device>', value)
        value = re.sub(r'\byeney:[0-9a-f]{24}\b', '<item>', value)
        value = re.sub(r'\b(?:\d{1,3}\.){3}\d{1,3}\b', '<address>', value)
        value = re.sub(r'[a-zA-Z][a-zA-Z0-9+.-]*://[^\s"<>\\]+', '<uri>', value)
        value = re.sub(r'(?i)(\b(?:householdId|groupId|playerId|deviceId|locationId|queueId|serialNumber|macAddress)"\s*:\s*")[^"]*', r'\1<private>', value)
        value = re.sub(r'(?i)\b(?:[0-9a-f]{2}[:-]){5}[0-9a-f]{2}\b', '<device>', value)
        return value


class Speaker:
    def __init__(self, host, records, port=1400, ws_port=1443):
        self.host = host
        self.port = port
        self.ws_port = ws_port
        self.records = records

    def http(self, method, path, body=None, headers=None):
        with contextlib.closing(http.client.HTTPConnection(self.host, self.port, timeout=2)) as conn:
            conn.putrequest(method, path, skip_host=True, skip_accept_encoding=True)
            conn.putheader('Host', f'{self.host}:{self.port}')
            conn.putheader('Connection', 'close')
            conn.putheader('Content-Length', str(len(body) if body else 0))
            for key, value in (headers or {}).items():
                conn.putheader(key, value)
            conn.endheaders(body)
            reply = conn.getresponse()
            raw = reply.read(2_000_001).decode(errors='replace')
            if reply.status != 200 or len(raw) > 2_000_000:
                raise ValueError(f'{method} {path} HTTP {reply.status}: {raw}')
            return raw

    def call(self, service, action, **kwargs):
        ns = service_type(service)
        arguments = ''.join(f'<{key}>' + escape(str(value), {'"': '&quot;'})
                            + f'</{key}>' for key, value in kwargs.items())
        body = ('<?xml version="1.0" encoding="utf-8"?>'
                '<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" '
                's:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/">'
                f'<s:Body><u:{action} xmlns:u="{ns}">{arguments}</u:{action}></s:Body></s:Envelope>')
        raw = self.http('POST', control_path(service), body.encode(),
                        {'Content-Type': 'text/xml', 'SOAPACTION': f'"{ns}#{action}"'})
        try:
            data = fields(raw)
            if action + 'Response' not in data:
                raise ValueError('missing response element')
        except (ET.ParseError, ValueError) as exc:
            raise ValueError(f'{action}: {exc}; raw answer: {raw}') from exc
        return data, raw

    def av(self, action, **kwargs):
        return self.call('AVTransport', action, InstanceID=0, **kwargs)[0]

    def volume(self):
        data, raw = self.call('RenderingControl', 'GetVolume', InstanceID=0, Channel='Master')
        try:
            value = int(data.get('CurrentVolume', ''))
            if 0 <= value <= 100:
                return value
        except ValueError:
            pass
        raise ValueError(f'invalid volume; raw answer: {raw}')

    def set_volume(self, value):
        self.call('RenderingControl', 'SetVolume', InstanceID=0, Channel='Master', DesiredVolume=value)

    def identity(self, room):
        _, raw = self.call('ZoneGroupTopology', 'GetZoneGroupState')
        try:
            result = next(node for node in ET.fromstring(raw).iter() if local(node.tag) == 'GetZoneGroupStateResponse')
            payload = next(node for node in result if local(node.tag) == 'ZoneGroupState')
            groups = payload if len(payload) else ET.fromstring(payload.text or '')
            for group in groups.iter():
                if local(group.tag) != 'ZoneGroup':
                    continue
                members = [node for node in group.iter()
                           if local(node.tag) in ('ZoneGroupMember', 'Satellite')]
                coordinator = group.get('Coordinator')
                for member in members:
                    self.records.private.update(member.get(key, '') for key in ('UUID', 'ZoneName', 'Location', 'SerialNumber'))
                    if member.get('ZoneName') != room:
                        continue
                    location = member.get('Location', '')
                    if (len(members) == 1 and member.get('UUID') == coordinator and
                            re.fullmatch(r'[A-Za-z0-9_-]+', coordinator or '') and
                            location.split('/')[2].split(':')[0] == self.host):
                        return coordinator
                    raise ValueError('room is grouped or is not the requested standalone speaker')
            raise ValueError('room is missing from topology')
        except (ET.ParseError, IndexError, StopIteration, ValueError) as exc:
            raise ValueError(f'{exc}; raw answer: {raw}') from exc

    def browse(self):
        rows = []
        update = None
        while True:
            data, raw = self.call('Queue', 'Browse', QueueID=0, StartingIndex=len(rows), RequestedCount=100)
            try:
                current = int(data['UpdateID'])
                if update is not None and current != update:
                    raise ValueError('queue changed while reading it')
                update = current
                entries = ET.fromstring(data['Result'])
                for item in entries:
                    uris = [node.text for node in item if local(node.tag) == 'res' and node.text]
                    rows.append(uris)
                if len(rows) == int(data['TotalMatches']):
                    return rows, update
                if not len(entries) or len(rows) > int(data['TotalMatches']):
                    raise ValueError('inconsistent queue count')
            except (ET.ParseError, KeyError, ValueError) as exc:
                raise ValueError(f'Browse: {exc}; raw answer: {raw}') from exc

    def socket(self):
        ws = timing.SonosSocket(self.host, self.ws_port)
        self.records.private.update((str(ws.group), str(ws.household)))
        return ws

    def description_path(self, advertised):
        base = f'http://{self.host}:{self.port}'
        address = urlsplit(urljoin(base + DESCRIPTION_PATH, advertised))
        if address.scheme != 'http' or address.netloc != urlsplit(base).netloc or address.fragment:
            raise ValueError('description URL is outside the speaker HTTP endpoint')
        return address.path + ('?' + address.query if address.query else '')

    def check_actions(self, volume, normal_play_mode=False):
        root = ET.fromstring(self.http('GET', DESCRIPTION_PATH))
        services = [{local(child.tag): (child.text or '').strip() for child in node}
                    for node in root.iter() if local(node.tag) == 'service']
        for service, expected in ACTIONS.items():
            if service == 'AVTransport' and normal_play_mode:
                expected = expected | {'SetPlayMode'}
            if service == 'RenderingControl' and volume is not None:
                expected = expected | {'SetVolume'}
            matches = [entry for entry in services if entry.get('serviceType') == service_type(service)]
            if len(matches) != 1:
                raise ValueError(f'{service} expected one service in the device description, found {len(matches)}')
            entry = matches[0]
            control = entry.get('controlURL') or ''
            used = control_path(service)
            try:
                matches_control = bool(control) and self.description_path(control) == used
            except ValueError:
                matches_control = False
            if not matches_control:
                raise ValueError(f'{service} advertises controlURL {control!r}, probe uses {used!r}')
            scpd = entry.get('SCPDURL') or ''
            if not scpd:
                raise ValueError(f'{service} has no SCPDURL')
            raw = self.http('GET', self.description_path(scpd))
            try:
                document = ET.fromstring(raw)
                actions = {child.text for node in document.iter() if local(node.tag) == 'action'
                           for child in node if local(child.tag) == 'name'}
            except ET.ParseError as exc:
                raise ValueError(f'{service} action list: {exc}') from exc
            missing = expected - actions
            if missing:
                raise ValueError(f'{service} missing {", ".join(sorted(missing))}')


def unit(room):
    escaped = subprocess.check_output(['systemd-escape', '--', room], text=True).strip()
    return f'yeney@{escaped}.service'


def service(unit_name, action):
    command = ['systemctl', action, unit_name]
    if action == 'show':
        command += ['--property=LoadState,ActiveState', '--no-pager']
    output = subprocess.check_output(command, text=True, stderr=subprocess.STDOUT)
    if action == 'show':
        info = dict(line.split('=', 1) for line in output.splitlines() if '=' in line)
        if info.get('LoadState') != 'loaded':
            raise ValueError(f'{unit_name} is not loaded: {output.strip()}')
        state = info.get('ActiveState')
        if state not in ('active', 'inactive', 'failed'):
            raise ValueError(f'{unit_name} is in transitional state {state}')
        return state == 'active'


def metadata(uri, mime, rate, frames, length, channels, bits):
    document = ET.Element('DIDL-Lite', {'xmlns': 'urn:schemas-upnp-org:metadata-1-0/DIDL-Lite/',
                                        'xmlns:dc': 'http://purl.org/dc/elements/1.1/',
                                        'xmlns:upnp': 'urn:schemas-upnp-org:metadata-1-0/upnp/'})
    item = ET.SubElement(document, 'item', id='yeney:' + uri.rsplit('/', 1)[-1].split('.')[0],
                         parentID='0', restricted='true')
    ET.SubElement(item, 'dc:title').text = 'YeneY refill probe'
    ET.SubElement(item, 'dc:creator').text = 'YeneY'
    ET.SubElement(item, 'upnp:artist').text = 'YeneY'
    ET.SubElement(item, 'upnp:album').text = 'Refill probe'
    ET.SubElement(item, 'upnp:class').text = 'object.item.audioItem.musicTrack'
    seconds = frames // rate
    duration = f'{seconds // 3600}:{seconds // 60 % 60:02}:{seconds % 60:02}'
    if frames % rate:
        duration += f'.{(frames % rate) * 1_000_000_000 // rate:09}'
    ET.SubElement(item, 'res', protocolInfo=f'http-get:*:{mime}:*', duration=duration,
                  size=str(length), sampleFrequency=str(rate), bitsPerSample=str(bits),
                  nrAudioChannels=str(channels)).text = uri
    return ET.tostring(document, encoding='unicode')


def cleanup_rows(speaker, own):
    while True:
        rows, update = speaker.browse()
        found = [i for i, row in enumerate(rows, 1) if any(uri in own for uri in row)]
        if not found:
            return
        speaker.av('RemoveTrackRangeFromQueue', UpdateID=update, StartingIndex=found[-1], NumberOfTracks=1)
        after, _ = speaker.browse()
        if len(after) >= len(rows):
            raise ValueError('queue removal did not reduce the number of rows')


class Questions:
    def __init__(self, speaker, records, clock_scale):
        self.speaker = speaker
        self.records = records
        self.scale = clock_scale
        self.done = threading.Event()
        self.pending = {}
        self.lock = threading.Lock()
        self.ws = speaker.socket()

    def __enter__(self):
        self.ws.socket.settimeout(None)
        self.send_lock = threading.Lock()
        send = self.ws.send

        def serialized_send(*args):
            with self.send_lock:
                return send(*args)

        self.ws.send = serialized_send
        for namespace in ('playback:1', 'playbackMetadata:1'):
            self.ws.send(json.dumps([dict(namespace=namespace, command='subscribe', cmdId=namespace,
                                          groupId=self.ws.group, householdId=self.ws.household), {}]).encode())
        self.reader = threading.Thread(target=self.read, daemon=True)
        self.scheduler = threading.Thread(target=self.schedule, daemon=True)
        self.reader.start()
        self.scheduler.start()
        return self

    def __exit__(self, *_):
        self.done.set()
        with contextlib.suppress(OSError):
            self.ws.socket.shutdown(socket.SHUT_RDWR)
        self.scheduler.join()
        self.reader.join()
        self.ws.close()
        with self.lock:
            for sent in self.pending.values():
                self.result('websocket', sent, error='unanswered')
            self.pending.clear()

    def result(self, protocol, sent, received=None, pos=None, item='', state='', error=''):
        elapsed = None if received is None else received - sent
        self.records.add('questions', protocol=protocol, sent=sent - self.records.clock,
                         received=None if received is None else received - self.records.clock,
                         latency_ms=None if elapsed is None or elapsed > 2 else elapsed * 1000,
                         position_s=pos, item=item, state=state, error=error)

    def read(self):
        try:
            while not self.done.is_set():
                raw = self.ws.receive()
                self.records.add('speaker', protocol='websocket', raw=raw)
                if not isinstance(raw, list) or len(raw) != 2 or not all(isinstance(part, dict) for part in raw):
                    continue
                header, body = raw
                with self.lock:
                    sent = self.pending.pop(str(header.get('cmdId')), None)
                    if sent is None:
                        continue
                    try:
                        pos = float(body.get('positionMillis')) / 1000
                        if not math.isfinite(pos) or pos < 0:
                            pos = None
                    except (ValueError, TypeError):
                        pos = None
                    error = body.get('errorCode') or ('error' if ws_error(raw) else '')
                    self.result('websocket', sent, time.monotonic(), pos, body.get('itemId', ''),
                                body.get('playbackState', ''), error)
        except Exception as exc:
            if not self.done.is_set():
                self.records.add('speaker', protocol='websocket', error=str(exc))

    def soap_position(self, sent):
        try:
            data, raw = self.speaker.call('AVTransport', 'GetPositionInfo', InstanceID=0)
            received = time.monotonic()
            self.records.add('speaker', protocol='UPnP', action='GetPositionInfo', raw=raw)
            self.result('UPnP', sent, received, position(data.get('RelTime')), data.get('TrackURI', ''))
        except Exception as exc:
            self.result('UPnP', sent, error=str(exc))

    def schedule(self):
        with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
            start = time.monotonic()
            serial = 0
            futures = set()
            while not self.done.is_set():
                due = start + serial * self.scale / 4
                if self.done.wait(max(0, due - time.monotonic())):
                    break
                sent = time.monotonic()
                serial += 1
                cid = str(serial)
                with self.lock:
                    for key, old in list(self.pending.items()):
                        if sent - old >= 2:
                            self.result('websocket', old, error='unanswered')
                            del self.pending[key]
                    self.pending[cid] = sent
                try:
                    header = dict(namespace='playback:1', command='getPlaybackStatus', cmdId=cid,
                                  groupId=self.ws.group, householdId=self.ws.household)
                    self.ws.send(json.dumps([header, {}]).encode())
                except OSError:
                    with self.lock:
                        self.pending.pop(cid, None)
                        self.result('websocket', sent, error='connection closed')
                if serial % 2:
                    futures = {future for future in futures if not future.done()}
                    if len(futures) < 8:
                        futures.add(pool.submit(self.soap_position, sent))
                    else:
                        self.result('UPnP', sent, error='previous questions still pending')


def track(host, port, track_id, path):
    with contextlib.closing(http.client.HTTPConnection(host, port, timeout=15)) as connection:
        connection.request('GET', f'/music/{track_id}/download')
        response = connection.getresponse()
        if response.status != 200:
            raise ValueError(f'LMS track request returned HTTP {response.status}')
        with path.open('wb') as out:
            shutil.copyfileobj(response, out)


def local_route(host, port):
    with contextlib.closing(socket.socket(socket.AF_INET, socket.SOCK_DGRAM)) as connection:
        connection.connect((host, port))
        return connection.getsockname()[0]


def ws_error(message):
    if not isinstance(message, list) or len(message) != 2:
        return False
    header, body = message
    if not isinstance(header, dict) or not isinstance(body, dict):
        return False
    return bool(body.get('errorCode') or header.get('success') is False or
                any('error' in str(header.get(key, '')).lower() for key in ('type', 'name', 'command')))


def ws_check(speaker):
    with contextlib.closing(speaker.socket()) as ws:
        ws.send(json.dumps([dict(namespace='playback:1', command='getPlaybackStatus', cmdId='check',
                                 groupId=ws.group, householdId=ws.household), {}]).encode())
        deadline = time.monotonic() + 3
        while time.monotonic() < deadline:
            reply = ws.receive()
            if not isinstance(reply, list) or len(reply) != 2:
                raise ValueError(f'bad WebSocket response; raw answer: {reply!r}')
            header, body = reply
            if not isinstance(header, dict) or not isinstance(body, dict):
                raise ValueError(f'bad WebSocket response; raw answer: {reply!r}')
            if str(header.get('cmdId')) == 'check':
                if ws_error(reply):
                    raise ValueError(f'WebSocket position failed; raw answer: {reply!r}')
                return
        raise ValueError('no WebSocket position answer')


def stats(rows, expected=None):
    times = sorted(row['latency_ms'] for row in rows if row['latency_ms'] is not None)
    result = dict(count=len(rows), unanswered=len(rows) - len(times))
    if times:
        result.update(median_ms=statistics.median(times),
                      p95_ms=times[math.ceil(len(times) * .95) - 1],
                      above_50_pct=100 * sum(value > 50 for value in times) / len(times),
                      above_100_pct=100 * sum(value > 100 for value in times) / len(times))
    if expected:
        start, origin, scale = expected
        errors = [abs(row['position_s'] - origin - ((row['sent'] + row['received']) / 2 - start) / scale)
                  for row in rows if row['position_s'] is not None and row['received'] is not None
                  and row['sent'] >= start]
        if errors:
            result.update(position_median_ms=1000 * statistics.median(errors),
                          position_max_ms=1000 * max(errors))
    return result


def answer_time(row):
    return (row['sent'] + row['received']) / 2


def playing_answers(rows):
    return sorted((row for row in rows
                   if row['received'] is not None and row['position_s'] is not None and
                   not row.get('error') and str(row['state']).upper() in ('PLAYING', 'PLAYBACK_STATE_PLAYING')),
                  key=answer_time)


def join_gap(rows, anchor, duration, scale=1):
    """Read the two playback-clock intercepts closest to a row change."""
    near = sorted(rows, key=lambda row: abs(anchor - answer_time(row)))
    # UPnP identifies the change and supplies a coarse clock anchor. Choose
    # millisecond positions near the end of the previous row and the start of
    # the following row even when their midpoint precedes the UPnP reply.
    before = [row for row in near
              if duration - 5 <= row['position_s'] <= duration + .5][:8]
    after = [row for row in near if row['position_s'] <= 5][:8]
    if len(before) < 8 or len(after) < 8:
        return None
    previous_end = statistics.median(answer_time(row) + (duration - row['position_s']) * scale
                                     for row in before)
    next_start = statistics.median(answer_time(row) - row['position_s'] * scale for row in after)
    return 1000 * (next_start - previous_end)


def position_offset(rows, steady_start, steady_end, scale=1):
    if not rows:
        return None
    steady = [row for row in rows if steady_start <= answer_time(row) < steady_end]
    if not steady:
        return None
    origin = statistics.median(answer_time(row) - row['position_s'] * scale for row in steady)
    return 1000 * (origin - answer_time(rows[0]))


class Experiment:
    def __init__(self, args, work, speaker, records, scale=1, lms_port=9000, minimum=180):
        self.args = args
        self.work = work
        self.speaker = speaker
        self.records = records
        self.scale = scale
        self.lms_port = lms_port
        self.minimum = minimum
        self.results = []
        self.series = []
        self.measurements = []
        self.own = set()
        self.selection_attempted = False

    def prepare(self):
        source = self.work / 'source.flac'
        track(self.args.lms_host, self.lms_port, self.args.track_id, source)
        self.media = prepare_audio(source, self.work, self.args.cases, self.minimum)
        self.sizes = {}
        for name, audio in self.media.items():
            size = audio['path'].stat().st_size
            proof = audio['proof']
            self.sizes[name] = dict(bytes=size, samples=audio['frames'], bits=audio['bits'], **proof)
            self.records.log(f'{name} {size} B, {audio["frames"]} samples, {audio["bits"]}-bit')
            if proof:
                self.records.log(name + ' proof ' + ' '.join(f'{key}={value}' for key, value in proof.items()))
        if 'bound' in self.args.cases:
            packed = self.media['packed16']
            if packed['path'].stat().st_size >= 44 + 6 * packed['frames']:
                raise ValueError('packed FLAC item is not smaller than its advertised upper bound')

    def check(self, name):
        checks = [
            ('service', lambda: service(name, 'show')),
            ('WebSocket position', lambda: ws_check(self.speaker)),
            ('UPnP topology', lambda: self.speaker.identity(self.args.room)),
            ('UPnP transport', lambda: self.transport()),
            ('UPnP source', lambda: self.speaker.av('GetMediaInfo')),
            ('UPnP position', lambda: self.speaker.av('GetPositionInfo')),
            ('UPnP play mode', self.check_play_mode),
            ('UPnP queue', self.speaker.browse),
            ('UPnP volume', self.speaker.volume),
            ('UPnP advertised actions', lambda: self.speaker.check_actions(self.args.volume, self.normal_play_mode)),
            ('LMS FLAC track', self.prepare),
            ('HTTP listen address and port', self.check_port),
        ]
        failures = []
        for label, check in checks:
            try:
                check()
                self.records.log(label + ': pass')
            except Exception as exc:
                self.records.log(f'{label}: FAIL {error_text(exc)}')
                failures.append(label)
        self.records.log('check: ' + ('FAIL ' + ', '.join(failures) if failures else 'pass'))
        return 1 if failures else 0

    @property
    def normal_play_mode(self):
        return getattr(self.args, 'normal_play_mode', False)

    def play_mode(self):
        mode = self.speaker.av('GetTransportSettings').get('PlayMode', '').strip()
        crossfade = self.speaker.av('GetCrossfadeMode').get('CrossfadeMode', '').strip()
        self.records.log(f'speaker play mode {mode or "missing"}, crossfade {crossfade or "missing"}')
        if not mode or crossfade.lower() not in ('0', 'false'):
            raise ValueError('measurement would refuse without a known play mode and crossfade off')
        if mode.upper() != 'NORMAL' and not self.normal_play_mode:
            raise ValueError('measurement would refuse this play mode; use --normal-play-mode for the run')
        return mode

    def check_play_mode(self):
        if self.play_mode().upper() != 'NORMAL':
            self.records.log('measurement would temporarily set play mode to NORMAL')

    def check_port(self):
        host = local_route(self.speaker.host, self.speaker.port)
        with MediaServer(host, self.records) as server:
            self.records.log(f'HTTP listener {host}:{server.server_port}; routing and bind verified locally')

    def transport(self):
        data, raw = self.speaker.call('AVTransport', 'GetTransportInfo', InstanceID=0)
        self.records.add('speaker', protocol='UPnP', action='GetTransportInfo', raw=raw)
        state = data.get('CurrentTransportState', '').strip().upper()
        if not state:
            raise ValueError(f'missing transport state; raw answer: {raw}')
        return state, data.get('CurrentTransportStatus', '')

    def t(self):
        return time.monotonic() - self.records.clock

    def wait(self, since, seconds):
        time.sleep(max(0, since + seconds * self.scale - self.t()))

    def questions(self, since, until, protocol=None):
        return [row for row in list(self.records.rows) if row['kind'] == 'questions'
                and since <= row['sent'] < until and (protocol is None or row['protocol'] == protocol)]

    def playing(self, since):
        deadline = since + 8 * self.scale
        while self.t() < deadline:
            state, status = self.transport()
            if status.upper() not in ('', 'OK'):
                raise ValueError(f'transport status {status}')
            if state == 'PLAYING':
                return self.t()
            time.sleep(.1 * self.scale)
        raise ValueError('transport did not reach PLAYING')

    def latest_position(self, since):
        rows = self.questions(since, self.t(), 'websocket')
        return next((r['position_s'] for r in reversed(rows) if r['position_s'] is not None), None)

    def add_items(self, case):
        uris = []
        for form in CASES[case]:
            media = self.media[form]
            path, frames, rate = (media[key] for key in ('path', 'frames', 'rate'))
            bound = 44 + 6 * frames if case == 'bound' else None
            mime = 'audio/flac' if path.suffix == '.flac' else 'audio/wav'
            route = f'/{secrets.token_hex(12)}{path.suffix}'
            item = Item(path, frames / rate, bound=bound, index=media['index'], frames=frames)
            self.server.items[route] = item
            uri = f'http://{self.server.server_address[0]}:{self.server.server_port}{route}'
            self.own.add(uri)
            uris.append(uri)
            self.speaker.av('AddURIToQueue', EnqueuedURI=uri,
                            EnqueuedURIMetaData=metadata(uri, mime, rate, frames, item.length, media['channels'], media['bits']),
                            DesiredFirstTrackNumberEnqueued=0, EnqueueAsNext=0)
        rows, _ = self.speaker.browse()
        indices = [next(i for i, row in enumerate(rows, 1) if uri in row) for uri in uris]
        if indices != list(range(indices[0], indices[0] + len(indices))):
            raise ValueError('probe rows are not consecutive')
        return uris

    def choose(self, uri):
        rows, _ = self.speaker.browse()
        first = next((i for i, row in enumerate(rows, 1) if uri in row), None)
        if first is None:
            raise ValueError('probe row is missing')
        self.selection_attempted = True
        self.speaker.av('SetAVTransportURI', CurrentURI='x-rincon-queue:' + self.udn + '#0',
                        CurrentURIMetaData='')
        self.speaker.av('Seek', Unit='TRACK_NR', Target=first)

    def seek(self, seconds):
        sent = self.t()
        self.speaker.av('Seek', Unit='REL_TIME', Target=hms(seconds))
        return dict(sent=sent, acknowledged=self.t(), target=seconds)

    def advance(self, previous, following, since, deadline, target):
        repeated = False
        while self.t() < deadline:
            observations = self.questions(since, self.t(), 'UPnP')
            after = next((row for row in observations if row['item'] == following), None)
            if after:
                return answer_time(after), repeated
            positions = [row['position_s'] for row in observations
                         if row['item'] == previous and row['position_s'] is not None]
            repeated |= any(before >= target and current < target - 2
                            for before, current in zip(positions, positions[1:]))
            time.sleep(.25 * self.scale)
        raise ValueError('next probe item did not start')

    def measure(self, result):
        case = result['case']
        uris = self.add_items(case)
        first, second = uris[:2]
        durations = [self.media[form]['frames'] / self.media[form]['rate'] for form in CASES[case]]
        duration = durations[0]
        paths = [urlsplit(uri).path for uri in uris]
        self.choose(first)
        started = self.t()
        measurement = dict(result=result, paths=paths, started=started, seeks=[], joins=[], duration=duration)
        self.measurements.append(measurement)
        self.speaker.av('Play', Speed=1)
        result['start_playing_ms'] = (self.playing(started) - started) * 1000
        short = len(uris) == 3
        self.wait(started, 6 if short else 80)

        sought = self.seek(int(duration * .6))
        measurement['seeks'].append(sought)
        result['seek_playing_ms'] = (self.playing(sought['acknowledged']) - sought['sent']) * 1000
        self.wait(sought['sent'], 3 if short else 20)
        result['pause_position_s'] = self.latest_position(sought['sent'])
        paused = self.t()
        sought['end'] = paused
        self.speaker.av('Pause')
        self.wait(paused, 10)
        result['before_resume_position_s'] = self.latest_position(paused)

        resumed = self.t()
        self.speaker.av('Play', Speed=1)
        result['resume_playing_ms'] = (self.playing(resumed) - resumed) * 1000
        self.wait(resumed, 1)
        result['resume_position_s'] = self.latest_position(resumed)

        target = max(0, int(duration - 12))
        late = self.seek(target)
        measurement['seeks'].append(late)
        self.playing(late['acknowledged'])
        deadline = late['sent'] + (duration - target + 6) * self.scale
        join, repeated = self.advance(first, second, late['sent'], deadline, target)
        late['end'] = join
        result['join_repeated'] = int(repeated)
        measurement['joins'].append(dict(at=join, begin=late['acknowledged'],
                                         duration=duration, end=join + 6 * self.scale))
        if short:
            deadline = join + (durations[1] + 6) * self.scale
            last, _ = self.advance(second, uris[2], join, deadline, 0)
            measurement['joins'].append(dict(at=last, begin=join, duration=durations[1],
                                             end=last + 6 * self.scale))
            join = last
        self.wait(join, 10)

    def playback_figures(self, measurement):
        result = measurement['result']
        started, end = measurement['started'], measurement['end']
        rows = playing_answers(self.questions(started, end, 'websocket'))
        seeks = measurement['seeks']
        first_seek = seeks[0]['sent'] if seeks else end
        steady_start = max(started + 2 * self.scale, first_seek - 8 * self.scale)
        offset = position_offset(rows, steady_start, first_seek, self.scale)
        if offset is not None:
            result['position_offset_ms'] = offset
        for i, seek in enumerate(seeks):
            prefix = 'seek' if i == 0 else 'tail_seek'
            until = seek.get('end', end)
            found = next((row for row in rows if row['sent'] >= seek['acknowledged'] and
                          answer_time(row) < until), None)
            if found:
                result[prefix + '_landing_s'] = found['position_s']
                result[prefix + '_landing_ms'] = 1000 * (found['position_s'] - seek['target'])
            requests = [row for row in self.records.rows if row.get('path') == measurement['paths'][0]
                        and row.get('event') == 'open'
                        and seek['sent'] <= row['time'] < until]
            result[prefix + '_requests'] = len(requests)
            result[prefix + '_get_requests'] = sum(row['method'] == 'GET' for row in requests)
            result[prefix + '_head_requests'] = sum(row['method'] == 'HEAD' for row in requests)
            result[prefix + '_ranges'] = [row['range'] or 'full' for row in requests]
        for i, join in enumerate(measurement['joins']):
            points = [row for row in rows if join['begin'] <= answer_time(row) < join['end']]
            gap = join_gap(points, join['at'], join['duration'], self.scale)
            if gap is None:
                continue
            result['join_gap_ms' if i == 0 else 'second_join_gap_ms'] = gap

    def finalize_measurement(self, measurement):
        result, paths, started = (measurement[key] for key in ('result', 'paths', 'started'))
        self.playback_figures(measurement)
        if measurement['seeks']:
            self.latencies(result, 'after_seek', measurement['seeks'][0]['sent'], 40,
                           end=measurement['seeks'][0].get('end', measurement['end']))
        window_end = min(measurement['end'], started + 40 * self.scale)
        rows = sorted(self.questions(started, window_end, 'websocket'), key=lambda row: row['sent'])
        initial = next((row for row in rows if row['position_s'] is not None), None)
        advancing = next((row for row in rows if initial and row['item'] == initial['item']
                          and row['position_s'] is not None and row['position_s'] > initial['position_s']), None)
        expected = None
        if advancing:
            result['start_advancing_ms'] = (advancing['received'] - started) * 1000
            expected = ((advancing['sent'] + advancing['received']) / 2, advancing['position_s'], self.scale)
        self.latencies(result, 'refill', started, 40, expected, end=measurement['end'])
        self.latencies(result, 'steady', started + 60 * self.scale, 20, end=measurement['end'])
        seconds = [0] * 40
        opens = [0] * 40
        closes = [0] * 40
        ranges = [[] for _ in seconds]
        for row in list(self.records.rows):
            if row.get('path') not in paths or not started <= row['time'] < window_end:
                continue
            i = int((row['time'] - started) / self.scale)
            if row['kind'] == 'bytes':
                seconds[i] += row['size']
            elif row['event'] == 'open':
                opens[i] += 1
                ranges[i].append(row['range'] or 'full')
            elif row['event'] == 'close':
                closes[i] += 1
        elapsed = min(40, max(0, math.ceil((measurement['end'] - started) / self.scale)))
        complete = min(40, max(0, math.floor((measurement['end'] - started) / self.scale)))
        for i, size in enumerate(seconds[:elapsed]):
            self.series.append(dict(case=result['case'], repeat=result['repeat'], second=i + 1, bytes=size,
                                    opens=opens[i], closes=closes[i], ranges=ranges[i]))
        for horizon in (10, 20, 40):
            if complete >= horizon:
                result[f'bytes_{horizon}'] = sum(seconds[:horizon])
        result['peak_B_per_s'] = max(seconds)
        result['playback_errors'] = sum(
            row['kind'] == 'speaker' and row.get('protocol') == 'websocket' and ws_error(row.get('raw'))
            for row in self.records.rows if started <= row['time'] < measurement['end'])
        playing_rate = self.server.items[paths[0]].play_rate
        last_fast = max((i for i, count in enumerate(seconds) if count > playing_rate * 1.05), default=-1)
        if complete == 40 and last_fast < 39:
            result['settled_s'] = last_fast + 2

    def latencies(self, result, label, start, duration, expected=None, end=math.inf):
        for protocol in ('websocket', 'UPnP'):
            if start >= end:
                return
            rows = self.questions(start, min(end, start + duration * self.scale), protocol)
            key = f'{label}_{protocol}'
            overall = stats(rows, expected)
            result.update({f'{key}_{name}': value for name, value in overall.items()})
            result[key + '_windows'] = [
                stats([row for row in rows if start + i * self.scale <= row['sent']
                       < start + (i + 5) * self.scale], expected)
                for i in range(0, duration, 5)]

    def run(self, name):
        self.speaker.check_actions(self.args.volume, self.normal_play_mode)
        active = service(name, 'show')
        restart = False
        changed = False
        restore_mode = None
        try:
            if active:
                restart = True
                self.records.log(f'Stopping {name}')
                service(name, 'stop')
            self.udn = self.speaker.identity(self.args.room)
            state, _ = self.transport()
            source = self.speaker.av('GetMediaInfo')
            self.original_position = self.speaker.av('GetPositionInfo')
            self.original_queue, _ = self.speaker.browse()
            original_volume = self.speaker.volume()
            if state not in ('STOPPED', 'NO_MEDIA_PRESENT'):
                raise ValueError(f'room already has active or paused playback ({state})')
            if 'CurrentURI' not in source:
                raise ValueError('speaker did not report the current transport source')
            self.records.add('speaker', snapshot=dict(state=state, source=source.get('CurrentURI'),
                             queue_count=len(self.original_queue), volume=original_volume))
            play_mode = self.play_mode()
            if play_mode.upper() != 'NORMAL':
                restore_mode = play_mode
                self.speaker.av('SetPlayMode', NewPlayMode='NORMAL')
                if self.speaker.av('GetTransportSettings').get('PlayMode', '').strip().upper() != 'NORMAL':
                    raise ValueError('speaker did not enter NORMAL play mode')
            self.prepare()
            host = local_route(self.speaker.host, self.speaker.port)
            with MediaServer(host, self.records) as self.server:
                server_thread = threading.Thread(target=self.server.serve_forever, daemon=True)
                server_thread.start()
                try:
                    if self.args.volume is not None and self.args.volume != original_volume:
                        changed = True
                        self.speaker.set_volume(self.args.volume)
                    count = len(self.args.cases) * self.args.repeats
                    self.records.log(f'{count} cases, expected duration about {count * 145 / 60:.0f} min')
                    with Questions(self.speaker, self.records, self.scale):
                        for repeat in range(1, self.args.repeats + 1):
                            for case in self.args.cases:
                                result = dict(case=case, repeat=repeat)
                                self.results.append(result)
                                self.records.log(f'{case} repeat {repeat}')
                                try:
                                    self.measure(result)
                                except Exception as exc:
                                    result['error'] = error_text(exc)
                                    self.records.log(f'{case}: FAIL {result["error"]}')
                                finally:
                                    if self.measurements and self.measurements[-1]['result'] is result:
                                        self.measurements[-1]['end'] = self.t()
                                    self.reset(source)
                finally:
                    self.server.closing.set()
                    self.server.shutdown()
                    server_thread.join()
                    try:
                        self.reset(source)
                    finally:
                        if changed:
                            self.speaker.set_volume(original_volume)
        finally:
            try:
                if restore_mode is not None:
                    self.speaker.av('SetPlayMode', NewPlayMode=restore_mode)
                    if self.speaker.av('GetTransportSettings').get('PlayMode', '').strip() != restore_mode:
                        raise ValueError('speaker did not restore its previous play mode')
            finally:
                if restart:
                    self.records.log(f'Starting {name}')
                    service(name, 'start')

    def reset(self, source):
        if not self.own:
            return
        try:
            if self.selection_attempted:
                current = self.speaker.av('GetPositionInfo').get('TrackURI', '')
                if current in self.own:
                    self.speaker.av('Stop')
        finally:
            try:
                cleanup_rows(self.speaker, self.own)
            finally:
                if self.selection_attempted:
                    self.speaker.av('SetAVTransportURI', CurrentURI=source.get('CurrentURI', ''),
                                    CurrentURIMetaData=source.get('CurrentURIMetaData', ''))
                if self.selection_attempted and source.get('CurrentURI', '').startswith('x-rincon-queue:'):
                    row = self.original_position.get('Track', '')
                    if row.isdecimal() and 0 < int(row) <= len(self.original_queue):
                        self.speaker.av('Seek', Unit='TRACK_NR', Target=row)
                        offset = position(self.original_position.get('RelTime'))
                        if offset:
                            self.speaker.av('Seek', Unit='REL_TIME', Target=hms(offset))
        self.own.clear()
        self.selection_attempted = False

    def archive(self, destination):
        for measurement in self.measurements:
            self.finalize_measurement(measurement)
        columns = [('bytes_10', '10 s B'), ('bytes_20', '20 s B'), ('bytes_40', '40 s B'),
                   ('settled_s', 'settled s'), ('peak_B_per_s', 'peak B/s'),
                   ('refill_websocket_median_ms', 'WS p50 ms'), ('refill_websocket_p95_ms', 'WS p95 ms'),
                   ('refill_UPnP_median_ms', 'UPnP p50 ms'), ('refill_UPnP_p95_ms', 'UPnP p95 ms'),
                   ('start_playing_ms', 'start ms'), ('start_advancing_ms', 'advancing ms'),
                   ('seek_playing_ms', 'seek ms'), ('seek_landing_ms', 'seek landing ms'),
                   ('tail_seek_landing_ms', 'tail seek landing ms'), ('position_offset_ms', 'position offset ms'),
                   ('resume_playing_ms', 'resume ms'), ('join_gap_ms', 'join gap ms'),
                   ('second_join_gap_ms', 'second join gap ms')]
        averages = {}
        for case in self.args.cases:
            runs = [row for row in self.results if row['case'] == case]
            keys = sorted({key for row in runs for key, value in row.items()
                           if key != 'repeat' and isinstance(value, (int, float))})
            averages[case] = {key: statistics.mean(r[key] for r in runs if key in r) for key in keys}
            averages[case]['failures'] = sum('error' in r for r in runs)
        for label in ('refill', 'steady', 'after_seek'):
            for protocol in ('websocket', 'UPnP'):
                short = 'WS' if protocol == 'websocket' else protocol
                metrics = [('above_50_pct', '>50 ms %'), ('above_100_pct', '>100 ms %'),
                           ('unanswered', 'unanswered')]
                if label != 'refill':
                    metrics += [('median_ms', 'p50 ms'), ('p95_ms', 'p95 ms')]
                else:
                    metrics += [('position_median_ms', 'position p50 ms'), ('position_max_ms', 'position max ms')]
                columns.extend((f'{label}_{protocol}_{key}', f'{label} {short} {heading}')
                               for key, heading in metrics)
        columns.extend([('seek_requests', 'seek requests'), ('tail_seek_requests', 'tail seek requests'), ('pause_position_s', 'pause s'),
                        ('before_resume_position_s', 'before resume s'), ('resume_position_s', 'resume position s'),
                        ('join_repeated', 'join repeats'), ('playback_errors', 'playback errors'),
                        ('failures', 'failures')])
        render = lambda value: f'{value:.1f}' if value is not None else '—'
        table = ['case\t' + '\t'.join(name for _, name in columns)]
        table += [case + '\t' + '\t'.join(render(row.get(key)) for key, _ in columns)
                  for case, row in averages.items()]
        delta_keys = {'bytes_20', 'refill_websocket_median_ms', 'refill_websocket_p95_ms',
                      'refill_UPnP_median_ms', 'refill_UPnP_p95_ms', 'start_playing_ms', 'seek_playing_ms'}
        delta = [(key, label) for key, label in columns if key in delta_keys]
        table += ['', 'against wav', 'case\t' + '\t'.join(label for _, label in delta)]
        baseline = averages.get('wav', {})
        for case, row in averages.items():
            if case != 'wav':
                table.append(case + '\t' + '\t'.join(render(row[key] - baseline[key])
                             if key in row and key in baseline else '—' for key, _ in delta))
        summary_text = '\n'.join(table) + '\n'
        print(summary_text, end='')
        rows = list(self.records.rows)

        def tsv(values, names):
            text = io.StringIO()
            writer = csv.DictWriter(text, fieldnames=names, delimiter='\t', extrasaction='ignore')
            writer.writeheader()
            writer.writerows(values)
            return text.getvalue()

        def json_lines(kind):
            return ''.join(json.dumps(row, ensure_ascii=False) + '\n' for row in rows if row['kind'] == kind)

        try:
            program = subprocess.check_output([ROOT / 'yeney', '--version'], text=True, timeout=5,
                                              stderr=subprocess.STDOUT).strip()
        except (OSError, subprocess.SubprocessError):
            program = (ROOT / 'VERSION').read_text().strip() + ' (checkout version)'
        files = {
            'per-second.tsv': tsv(self.series, ['case', 'repeat', 'second', 'bytes', 'opens', 'closes', 'ranges']),
            'questions.tsv': tsv((r for r in rows if r['kind'] == 'questions'),
                                 ['protocol', 'sent', 'received', 'latency_ms', 'position_s', 'item', 'state', 'error']),
            'requests.jsonl': json_lines('requests'),
            'speaker.jsonl': json_lines('speaker'),
            'summary.txt': summary_text,
            'summary.json': json.dumps(dict(audio=getattr(self, 'sizes', {}), averages=averages,
                                            runs=self.results), indent=2, ensure_ascii=False),
            'probe.log': json_lines('log'),
            'versions.txt': f'YeneY {program}\nrefill probe {VERSION}\n',
        }
        with destination.open('xb') as stream, tarfile.open(fileobj=stream, mode='w:gz') as archive:
            for name, value in files.items():
                data = self.records.redact(value).encode()
                entry = tarfile.TarInfo(name)
                entry.size = len(data)
                archive.addfile(entry, io.BytesIO(data))
        print(destination, flush=True)


def error_text(exc):
    if isinstance(exc, subprocess.CalledProcessError):
        return (exc.stderr or exc.output or str(exc)).strip()
    return str(exc)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--speaker', type=ipaddress.IPv4Address, required=True)
    parser.add_argument('--room', required=True)
    parser.add_argument('--lms-host', type=ipaddress.IPv4Address, required=True)
    parser.add_argument('--track-id', type=int, required=True)
    parser.add_argument('--volume', type=int)
    parser.add_argument('--cases', default=','.join(CASES))
    parser.add_argument('--repeats', type=int, default=1)
    parser.add_argument('--normal-play-mode', action='store_true')
    parser.add_argument('--check', action='store_true')
    args = parser.parse_args()
    args.cases = [part.strip() for part in args.cases.split(',')]
    args.speaker, args.lms_host = str(args.speaker), str(args.lms_host)
    if (args.track_id < 1 or args.repeats < 1 or args.volume is not None and not 0 <= args.volume <= 100 or
            len(set(args.cases)) != len(args.cases) or any(case not in CASES for case in args.cases)):
        parser.error('invalid track id, volume, repeat count, or cases')
    if os.geteuid() != 0:
        parser.error('run as root')
    os.umask(0o077)
    name = unit(args.room)
    records = Records()
    records.private.update((args.room, args.speaker, args.lms_host, name))
    speaker = Speaker(args.speaker, records)
    with tempfile.TemporaryDirectory(prefix='yeney-refill-audio-') as directory:
        experiment = Experiment(args, Path(directory), speaker, records)
        if args.check:
            return experiment.check(name)
        now = datetime.datetime.now().strftime('%Y-%m-%d-%H%M%S-%f')
        destination = Path('/tmp') / f'yeney-refill-probe-{now}.tar.gz'
        status = 0

        def interrupt(_signum, _frame):
            signal.signal(signal.SIGINT, signal.SIG_IGN)
            signal.signal(signal.SIGTERM, signal.SIG_IGN)
            raise KeyboardInterrupt

        signal.signal(signal.SIGINT, interrupt)
        signal.signal(signal.SIGTERM, interrupt)
        try:
            experiment.run(name)
            status = int(any('error' in result for result in experiment.results))
        except KeyboardInterrupt:
            records.log('Interrupted')
            status = 130
        except Exception as exc:
            records.log(f'FAIL {error_text(exc)}')
            status = 1
        finally:
            experiment.archive(destination)
        return status


if __name__ == '__main__':
    raise SystemExit(main())
