# Installed together by make install. Reuse the existing audited CLI/room helpers.
HERE = Path(__file__).resolve().parent
sys.path.insert(0,str(HERE))

PACING = runpy.run_path(str(HERE/'yeney-stream-pacing-suite'))
QUEUE = runpy.run_path(str(HERE/'yeney-queue-suite'))
SuiteError = PACING['SuiteError']
records = PACING['records']
PREFS = ('transitionType', 'transitionDuration', 'transitionSmart')
CHECKLIST = """Optional listening checklist:
- Listen for a gap or click at each join; uninterrupted audio is expected.
- Confirm LMS pause holds and resume continues the same item.
- Confirm stop/new play starts once. Sonos-app stop and pause/resume should
  appear in LMS within three seconds outside the own-command window.
- Sonos-app next/previous and seeks remain parked."""


def xml_sanitize(text):
    """Match upnp/xml.cpp xmlSanitize, including malformed-prefix consumption."""
    raw = text.encode('utf-8','surrogatepass') if isinstance(text,str) else text
    out = bytearray()
    p = 0
    while p < len(raw):
        start = p
        lead = raw[p]; p += 1
        code, width, minimum, valid = lead, 1, 0, True
        if 0xc2 <= lead <= 0xdf: code, width, minimum = lead & 31, 2, 0x80
        elif 0xe0 <= lead <= 0xef: code, width, minimum = lead & 15, 3, 0x800
        elif 0xf0 <= lead <= 0xf4: code, width, minimum = lead & 7, 4, 0x10000
        elif lead >= 0x80: valid = False
        for _ in range(1,width):
            if not valid or p == len(raw) or raw[p] & 0xc0 != 0x80:
                valid = False
                break
            code = (code << 6) | (raw[p] & 63); p += 1
        if not valid or code < minimum or code > 0x10ffff:
            out.extend(b'\xef\xbf\xbd')
        elif code in (9,10,13) or 32 <= code <= 0xd7ff or 0xe000 <= code <= 0xfffd or 0x10000 <= code <= 0x10ffff:
            out.extend(raw[start:p])
    return out.decode('utf-8')


def cli_word(word):
    # Repair metadata from the original percent-decoded bytes. Python's default
    # UTF-8 replacement would otherwise lose the sequence boundaries YeneY uses.
    raw = unquote_to_bytes(word)
    key, separator, value = raw.partition(b':')
    if separator and key in (b'title',b'artist',b'album'):
        return key.decode()+':'+xml_sanitize(value)
    return raw.decode('utf-8','replace')


def expected_metadata(track, title_format):
    title, artist, album = (xml_sanitize(track.get(k,'')) for k in ('title','artist','album'))
    if title_format == 'artist-title' and artist:
        title = artist+' - '+title
    return title, album


def local(tag):
    return tag.rsplit('}', 1)[-1]


def fields(node):
    return {local(c.tag): c.text or '' for c in node}


def seconds(value):
    parts = str(value).split(':')
    result = sum(float(v)*60**i for i, v in enumerate(reversed(parts)))
    if not math.isfinite(result) or result < 0:
        raise SuiteError('invalid clock value: '+str(value))
    return result


class CLITimeout(SuiteError):
    pass


class CLI:
    # One request per connection, even after success: delayed responses cannot
    # enter the next transaction. URLs retain LMS's existing percent escapes.
    def __init__(self, host, log, port=9090, query_timeout=3, mutation_timeout=30):
        self.host,self.log,self.port=host,log,port
        self.query_timeout,self.mutation_timeout=query_timeout,mutation_timeout

    def fresh(self):
        return CLI(self.host,self.log,self.port,self.query_timeout,self.mutation_timeout)

    @staticmethod
    def same(a,b):
        return a==b or (urlsplit(a).scheme in ('file','http','https') and unquote(a)==unquote(b))

    def call(self,*args):
        args=list(map(str,args))
        query=args[-1]=='?' or args[0] in ('players','titles','syncgroups') or (len(args)>1 and args[1] in ('status','favorites','podcasts'))
        timeout=self.query_timeout if query else self.mutation_timeout
        request=' '.join(quote(a,safe=':/%?,&=+' if urlsplit(a).scheme in ('file','http','https') else ':,?') for a in args)
        self.log('CLI > '+request+' timeout_s='+str(timeout))
        started=time.monotonic();deadline=started+timeout
        try:
            with socket.create_connection((self.host,self.port),timeout=min(3,timeout)) as connection:
                connection.settimeout(max(.001,deadline-time.monotonic()))
                connection.sendall((request+'\n').encode())
                response=bytearray()
                while b'\n' not in response:
                    remaining=deadline-time.monotonic()
                    if remaining<=0:raise TimeoutError('deadline')
                    connection.settimeout(remaining)
                    part=connection.recv(65536)
                    if not part:raise SuiteError('LMS CLI closed before response')
                    response.extend(part)
                    if len(response)>16*1024*1024:raise SuiteError('LMS CLI response limit')
            words=[cli_word(w) for w in bytes(response).splitlines()[0].split()]
            prefix=args[:-1] if args[-1]=='?' else args
            if len(words)<len(prefix) or any(not self.same(a,b) for a,b in zip(prefix,words)):
                raise SuiteError('LMS CLI echo mismatch: '+request)
            if any(w.startswith(('error:','badparams:')) for w in words[len(prefix):]):
                raise SuiteError('LMS CLI rejected command: '+request)
            self.log('CLI < '+repr(words)+' duration_s='+str(round(time.monotonic()-started,3)))
            return words
        except TimeoutError as error:
            self.log('CLI timeout; connection discarded: '+request)
            raise CLITimeout('LMS CLI timeout after '+str(timeout)+' s: '+request) from error
        except Exception as error:
            self.log('CLI failed; connection discarded: '+request+' '+str(error))
            raise SuiteError(str(error)) from error


class Speaker:
    """Speaker evidence, verified backup and room-only temporary volume."""
    def __init__(self, host, log):
        self.base = 'http://'+host+':1400'
        self.log = log
        # Disable environment HTTP proxies for the local device transaction.
        self.http = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        with self.http.open(self.base+'/xml/device_description.xml', timeout=3) as r:
            root = ET.fromstring(r.read(2*1024*1024))
        self.services = {}
        self.udn = next(n.text.removeprefix('uuid:') for n in root.iter() if local(n.tag) == 'UDN')
        for n in root.iter():
            if local(n.tag) == 'service':
                v = fields(n)
                self.services[v['serviceType'].split(':')[-2]] = (v['serviceType'], urljoin(self.base, v['controlURL']))

    def call(self, service, action, **args):
        name = 'SOAP '+service+' '+action
        self.log(name+' request '+json.dumps(args,sort_keys=True))
        status = None
        try:
            urn, url = self.services[service]
            data = ('<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/"><s:Body>'
                    '<u:'+action+' xmlns:u="'+urn+'">'+''.join('<'+k+'>'+escape(str(v))+'</'+k+'>' for k,v in args.items())+
                    '</u:'+action+'></s:Body></s:Envelope>').encode()
            request = urllib.request.Request(url, data, {'Content-Type':'text/xml; charset="utf-8"', 'SOAPAction':'"'+urn+'#'+action+'"'})
            try:
                with self.http.open(request, timeout=3) as r:
                    status, body = r.status, r.read(4*1024*1024)
            except urllib.error.HTTPError as error:
                with error:
                    status, body = error.code, error.read(4*1024*1024)
            try:
                root = ET.fromstring(body)
            except ET.ParseError as error:
                raise SuiteError('HTTP '+str(status)+' invalid SOAP body') from error
            fault = next((n for n in root.iter() if local(n.tag)=='Fault'),None)
            if fault is not None:
                details = {local(n.tag): n.text or '' for n in fault.iter()}
                message = 'HTTP '+str(status)+' UPnPError '+details.get('errorCode','unknown')
                description = details.get('errorDescription') or details.get('faultstring')
                if description:
                    message += ' '+description
                raise SuiteError(message)
            if status != 200:
                raise SuiteError('HTTP '+str(status)+' without SOAP fault')
            response = next((n for n in root.iter() if local(n.tag)==action+'Response'),None)
            if response is None:
                raise SuiteError('HTTP '+str(status)+' missing SOAP response')
            result = fields(response)
        except Exception as error:
            message = name+' failed: '+str(error)
            self.log(message)
            raise SuiteError(message) from error
        self.log(name+' succeeded: HTTP '+str(status))
        return result

    def standalone(self):
        root = ET.fromstring(self.call('ZoneGroupTopology','GetZoneGroupState')['ZoneGroupState'])
        groups = [n for n in root.iter() if local(n.tag) == 'ZoneGroup' and any(
            c.get('UUID') == self.udn for c in n.iter())]
        if len(groups) != 1 or groups[0].get('Coordinator') != self.udn:
            raise SuiteError('room is a member of another Sonos group; refusing control')
        members = [c for c in groups[0].iter() if local(c.tag) in ('ZoneGroupMember','Satellite')]
        return len(members)

    def browse(self, object_id):
        result, start, update = [], 0, None
        while True:
            v = (self.call('Queue','Browse',QueueID=0,StartingIndex=start,RequestedCount=250) if object_id=='Q:0' else
                 self.call('ContentDirectory','Browse',ObjectID=object_id,BrowseFlag='BrowseDirectChildren',
                           Filter='*',StartingIndex=start,RequestedCount=250,SortCriteria=''))
            if update is not None and v['UpdateID'] != update:
                raise SuiteError('queue changed during Browse')
            update = v['UpdateID']
            page = list(ET.fromstring(v['Result']))
            result.extend(dict(fields(n), id=n.get('id','')) for n in page)
            start += len(page)
            if start >= int(v['TotalMatches']):
                return result
            if not page or start > 1000000:
                raise SuiteError('incomplete queue Browse')

    def volume(self):
        return self.call('RenderingControl','GetVolume',InstanceID=0,Channel='Master')['CurrentVolume']

    def set_volume(self,value):
        self.call('RenderingControl','SetVolume',InstanceID=0,Channel='Master',DesiredVolume=int(value))
        if int(self.volume())!=int(value): raise SuiteError('speaker volume not applied')

    def crossfade(self):
        return self.call('AVTransport','GetCrossfadeMode',InstanceID=0)['CrossfadeMode']

    def evidence(self):
        p = self.call('AVTransport','GetPositionInfo',InstanceID=0)
        t = self.call('AVTransport','GetTransportInfo',InstanceID=0)
        metadata = fields(ET.fromstring(p['TrackMetaData'])[0]) if p.get('TrackMetaData','').startswith('<') else {}
        return dict(track=int(p['Track']), uri=p['TrackURI'], rel=seconds(p['RelTime']),
                    state=t['CurrentTransportState'], status=t.get('CurrentTransportStatus','OK'), metadata=metadata,
                    duration=seconds(p['TrackDuration']) if p.get('TrackDuration','').count(':')==2 else None)


class RemoteNotStarted(SuiteError):
    pass


class Suite(PACING['Suite']):
    def __init__(self, room, server, *, speaker=None, album=None, volume=10, remote=None, **kwargs):
        super().__init__(room, server, **kwargs)
        # Parent constructor creates only an archive workspace, never a service.
        self.cli = kwargs.get('cli') or CLI(server, self.log)
        self.album_choice, self.test_volume = album, volume
        self.remote_argument, self.remote_pool = remote, []
        if not 0 <= volume <= 100: raise SuiteError("volume must be 0–100")
        self.speaker = speaker
        self.results, self.selected = [], {}
        self.locks = []
        self.current = None
        self.last_sample = None
        self.due = 0
        self.release_verified = False
        self.ws = None
        self.ws_mode = 'queue'
        self.ws_report = {}
        self.backup_note = 'backup not assessed'
        self.not_restored = []
        self.title_format = 'artist-title'

    def lock(self):
        # Also honor both existing suite lock namespaces. Hold them to exclude
        # a pacing or phase-2 suite starting during this transaction.
        paths = [self.output/(n+self.room.encode().hex()+'.lock') for n in
                 ('yeney-queue-device-suite-', 'yeney-stream-pacing-')]
        paths.append(self.output/'yeney-queue-suite.lock')
        for path in paths:
            fd = os.open(path, os.O_CREAT|os.O_RDWR|os.O_NOFOLLOW, 0o600)
            held = os.fdopen(fd, 'w')
            try:
                fcntl.flock(held, fcntl.LOCK_EX|fcntl.LOCK_NB)
            except OSError:
                held.close()
                raise SuiteError('another suite holds the room lock')
            self.locks.append(held)

    def isolated(self):
        if self.speaker:
            self.group_members = self.speaker.standalone()
            words = self.cli.call('syncgroups','?')
            if '?' in words:
                raise SuiteError('LMS sync isolation unverified')
            for w in words:
                if w.startswith('sync_members:'):
                    members = set(w.partition(':')[2].lower().split(','))
                    if self.mac and self.mac.lower() in members and members != {self.mac.lower()}:
                        raise SuiteError('LMS room synced')
        else:
            super().isolated()

    def playlist_entries(self):
        count = int(self.query('playlist','tracks'))
        if not 0 <= count <= 1000000:
            raise SuiteError('invalid playlist count')
        rows = []
        for start in range(0, count, 250):
            rows += records(self.cli.call(self.mac,'status',str(start),'250','tags:ut'), 'playlist index')
        if len(rows) != count or any(int(r['playlist index']) != i or not (r.get('id') or r.get('url')) for i,r in enumerate(rows)):
            raise SuiteError('cannot save complete LMS playlist URLs/order')
        return [dict(id=r.get('id',''),url=r.get('url','')) for r in rows]

    def playlist(self):
        return [r['url'] for r in self.playlist_entries()]

    def fresh_cli(self):
        if hasattr(self.cli,'fresh'):
            self.cli=self.cli.fresh()

    @staticmethod
    def entries_equal(a,b):
        def remote(entry):
            url=entry.get('url','')
            return entry.get('id','').startswith('-') or (bool(url) and urlsplit(url).scheme.lower()!='file')
        def equal(actual,expected):
            # LMS assigns a new negative ID when a remote URL is loaded again.
            if remote(actual) or remote(expected) or not expected.get('id'):
                return CLI.same(actual.get('url',''),expected.get('url',''))
            return actual.get('id')==expected['id']
        return len(a)==len(b) and all(equal(x,y) for x,y in zip(a,b))

    def lms_ready(self,entries,mode=None,queue=False,deadline=None):
        deadline=self.backend.now()+60 if deadline is None else deadline
        last='no reply'
        while self.backend.now()<=deadline:
            try:
                actual=self.playlist_entries()
                actual_mode=self.query('mode')
                if self.entries_equal(actual,entries) and (mode is None or actual_mode==mode):
                    if queue:
                        p=self.diagnostic()
                        if p.get('state') not in ('STOPPED','PLAYING','PAUSED'):
                            raise SuiteError('queue preparation not ready')
                    self.log('LMS ready: playlist and mode verified')
                    return
                last='playlist/mode not yet expected'
            except (SuiteError,OSError,ValueError,KeyError) as error:
                last=str(error)
                self.fresh_cli()
            self.backend.sleep(1)
        raise SuiteError('LMS readiness timeout: '+last)

    def pending_mutation(self,*args):
        try:
            self.mutate(*args)
        except CLITimeout as error:
            self.log('mutation outcome unknown; verify without resending: '+str(error))
            self.fresh_cli()

    def library(self):
        tracks, offset, seen = [], 0, set()
        while True:
            words = self.cli.call('titles',str(offset),'250','tags:adeloTtixuQ','sort:albumtrack')
            if 'rescan:1' in words:
                raise SuiteError('library scan in progress')
            page = records(words,'id')
            total = next((int(w[6:]) for w in words if w.startswith('count:')), None)
            for t in page:
                if t['id'] in seen:
                    raise SuiteError('library pagination repeated ID')
                seen.add(t['id'])
            tracks += page
            offset += len(page)
            if total is None or (not page and offset < total) or offset > 1000000:
                raise SuiteError('incomplete library pagination')
            if offset >= total:
                break
        def eligible(t):
            return (t.get('id','').isdigit() and t.get('album_id','').isdigit() and
                    QUEUE['number'](t.get('duration')) >= 60 and
                    QUEUE['number'](t.get('samplerate')) in (44100,48000,44.1,48) and
                    t.get('remote','0') == '0' and t.get('url','').startswith('file://'))
        good = [t for t in tracks if eligible(t)]
        albums = collections.defaultdict(list)
        for track in good:
            if QUEUE['codec'](track): albums[track['album_id']].append(track)
        group = next((v for key,v in albums.items() if len(v)>=4 and
                     (self.album_choice is None or str(self.album_choice)==key or self.album_choice==v[0].get('album'))),None)
        if not group: raise SuiteError('need selected album with four eligible local lossless tracks >=60 s')
        self.selected={'album':group}
        for name,rates in (('high-rate-44100',(88200,176400,88.2,176.4)),
                           ('high-rate-48000',(96000,192000,96,192))):
            choice=next((t for t in tracks if t.get('id','').isdigit() and
                         t.get('remote','0')=='0' and t.get('url','').startswith('file://') and
                         QUEUE['codec'](t) and QUEUE['number'](t.get('duration'))>=10 and
                         QUEUE['number'](t.get('samplerate')) in rates),None)
            self.selected[name]=[choice] if choice else []
        choice,self.remote_note=self.remote_choice()
        self.selected['remote-source']=[choice] if choice else []
        with (self.work/'manifest.tsv').open('w',newline='') as f:
            writer=csv.writer(f,delimiter='\t');writer.writerow(['scenario','index','id','title','album','album_id','codec','samplerate','duration','url'])
            for name, entries in self.selected.items():
                for i,t in enumerate(entries):
                    writer.writerow([name,i,t['id'],t.get('title',''),t.get('album',''),t.get('album_id',''),QUEUE['codec'](t),t['samplerate'],t['duration'],t['url']])

    @staticmethod
    def remote_container(row):
        url=row.get('url','')
        if url.startswith('podcast://'):url=url[len('podcast://'):]
        path=urlsplit(url).path.lower().rstrip('/')
        return (row.get('hasitems')=='1' or row.get('type','').lower() in
                ('playlist','link','outline','opml','feed','rss') or
                path.endswith(('.rss','.xml','.opml','.atom','.m3u','.m3u8','.pls','.asx')))

    def remote_choice(self):
        # Read-only menu traversal. A favourite can be a feed despite type=audio.
        notes=[]; pool=[]; requested=self.remote_argument
        direct=bool(requested and ('://' in requested or urlsplit(requested).scheme in ('http','https','podcast','mms','rtsp')))
        def track(row,menu):
            return dict(id='',url=row['url'],title=row.get('title') or row.get('name',''),
                        artist='',album='',remote='1',samplerate='',duration='0',remote_menu=menu)
        if direct and not self.remote_container(dict(url=requested)) and not requested.startswith('file:'):
            self.remote_pool=[track(dict(url=requested,title=requested),'explicit --remote')]
            return self.remote_pool[0],'explicit --remote'
        for menu in ('favorites','podcasts'):
            pending=[(None,not requested)];seen=set()
            while pending and len(seen)<20 and len(pool)<5:
                ident,selected=pending.pop(0)
                key=(ident,selected)
                if key in seen:continue
                seen.add(key)
                args=[self.mac,menu,'items','0','100','want_url:1']
                if ident is not None:args.append('item_id:'+ident)
                try:rows=records(self.cli.call(*args),'id')
                except (SuiteError,OSError) as error:
                    notes.append(menu+': '+str(error));continue
                for row in rows:
                    url=row.get('url','')
                    match=bool(requested and (url==requested or requested in (row.get('title'),row.get('name'))))
                    eligible=selected or match
                    container=self.remote_container(row)
                    if eligible and url and not url.startswith('file:') and not container:
                        if all(t['url']!=url for t in pool):pool.append(track(row,menu))
                        if len(pool)==5:break
                    if row.get('id') and (container or not url):
                        pending.append((row['id'],eligible))
        self.remote_pool=pool
        if pool:return pool[0],pool[0]['remote_menu']
        return None,('no playable audio for --remote '+repr(requested) if requested else
                     'no playable favourite or podcast episode')+('; '+'; '.join(notes) if notes else '')

    def remote_strm(self, since, deadline):
        # STMc acknowledges a new strm s on both relay and stream paths. The
        # queue-command line is earlier evidence when coming from a local item.
        while True:
            text=self.backend.run('journalctl','-u',self.unit,'--since','@'+format(since,'.6f'),
                                  '--until','@'+format(since+5,'.6f'),'--no-pager','-o','cat')
            if re.search(r'(?:^|\n)core: (?:STMc(?:\s|$)|queue command strm s(?:\s|$))',text):return
            if self.backend.now()>=deadline:
                raise RemoteNotStarted('LMS sent no strm s within 5 s')
            self.backend.sleep(min(.2,deadline-self.backend.now()))

    def diagnostic(self):
        s = json.loads((self.state_root/('stream-pacing-'+self.room.encode().hex()+'.json')).read_text())
        age = self.backend.now()-s['monotonic_ms']/1000
        if s['pid'] != self.pid or not 0 <= age <= 3:
            raise SuiteError('stale or wrong-process room status')
        p = s['playback']
        if self.current is None and (p['requested'] != 'queue' or p['active'] != 'queue'):
            raise SuiteError('queue not selected: '+p.get('reason','unknown'))
        return p

    def setup(self):
        if not self.room or any(c in self.room for c in '\r\n\0=') or not self.server or any(c.isspace() or c in ':\0' for c in self.server):
            raise SuiteError('invalid room or server')
        self.lock()
        self.unit, self.state_root = PACING['STATE']['room_state'](self.room, self.backend.run,
            state_base=self.state_base, legacy_root=self.legacy_state_root)
        if not self.unit.startswith('yeney@') or not self.unit.endswith('.service') or '/' in self.unit or '\n' in self.unit:
            raise SuiteError('invalid room service unit')
        self.backend.run('systemctl','is-active','--quiet',self.unit)
        self.mac = self.player()
        rows = [r.split('\t') for r in self.backend.run(self.executable,'--list-rooms','--details').splitlines()]
        matches = [r for r in rows if len(r)==5 and r[0]==self.room]
        if len(matches)!=1 or matches[0][3]!=self.room:
            raise SuiteError('room is a member of another Sonos group; refusing control')
        ip = matches[0][2]
        self.speaker = self.speaker or Speaker(ip,self.log)
        self.speaker_ip = ip
        self.isolated()
        self.library()  # Fail for an unsuitable library before modifying anything.
        entries=self.playlist_entries()
        self.before = dict(entries=entries,playlist=[r['url'] for r in entries], index=self.query('playlist','index'), time=self.query('time'),
                           repeat=self.query('playlist','repeat'), shuffle=self.query('playlist','shuffle'), mode=self.query('mode'),
                           prefs={p:self.query('playerpref',p) for p in PREFS}, crossfade=self.speaker.crossfade(), volume=self.speaker.volume(),
                           environment=self.backend.run('systemctl','show',self.unit,'-p','Environment','--value'))
        if not self.entries_equal(self.playlist_entries(),self.before['entries']) or self.before['mode'] not in ('play','pause','stop'):
            raise SuiteError('LMS playlist changed during snapshot')
        if (self.before['repeat'] not in ('0','1','2') or self.before['shuffle'] not in ('0','1','2') or
                self.before['prefs']['transitionType'] not in ('0','1','2','3','4') or
                self.before['prefs']['transitionSmart'] not in ('0','1') or
                not math.isfinite(float(self.before['time'])) or float(self.before['time'])<0 or
                not 0 <= float(self.before['prefs']['transitionDuration']) <= 3600):
            raise SuiteError('invalid saved LMS preferences/time')
        if self.before['playlist'] and not 0 <= int(self.before['index']) < len(self.before['playlist']):
            raise SuiteError('invalid saved LMS index')
        environment = dict(word.split('=',1) for word in shlex.split(self.before['environment']) if '=' in word)
        configured = environment.get('YENEY_TITLE_FORMAT')
        self.title_format = 'title' if configured == 'title' else 'artist-title'
        if configured is not None and configured not in ('title','artist-title'):
            self.log('Warning: invalid room YENEY_TITLE_FORMAT='+repr(configured)+'; using artist-title')
        self.log('metadata comparison title_format='+self.title_format)
        (self.work/'before.json').write_text(json.dumps(self.before,indent=2)+'\n')
        original = self.speaker.browse('Q:0')
        owned = sum('/music/queue.wav?' in entry.get('res','') for entry in original)
        foreign = len(original)-owned
        self.log(f'Q:0 before takeover: entries={len(original)} owned={owned} foreign={foreign}')
        self.isolated()
        if not foreign:
            self.backup_note = 'backup not needed: '+('queue empty' if not original else 'only owned entries')
            self.log(self.backup_note)
            (self.work/'backup.json').write_text(json.dumps(dict(needed=False,reason=self.backup_note,entries=original),indent=2)+'\n')
        else:
            title = 'Before YeneY '+time.strftime('%Y-%m-%d %H:%M:%S')+' device suite'
            saved = self.speaker.call('AVTransport','SaveQueue',InstanceID=0,Title=title,ObjectID='')['AssignedObjectID']
            playlists = self.speaker.browse('SQ:')
            if not any(p['id']==saved and p.get('title')==title for p in playlists):
                raise SuiteError('Before YeneY backup identity unverified')
            if [p.get('res') for p in original] != [p.get('res') for p in self.speaker.browse(saved)]:
                raise SuiteError('Before YeneY backup contents unverified')
            (self.work/'backup.json').write_text(json.dumps(dict(id=saved,title=title,entries=original),indent=2)+'\n')
            self.backup_note = 'Before YeneY backup verified: '+saved
        directory = self.unit_root/(self.unit+'.d')
        if self.unit_root.is_symlink() or directory.is_symlink():
            raise SuiteError('symlinked drop-in directory')
        directory.mkdir(parents=True,exist_ok=True)
        self.dropin = directory/'queue-suite.conf'
        with self.dropin.open('x') as f:
            self.override = True
            f.write('[Service]\nEnvironment=YENEY_PLAYBACK_MODE=queue\n')
        self.playback = True
        self.speaker.set_volume(self.test_volume)
        self.restart()
        self.pid = self.connected()
        deadline = self.backend.now()+30
        while True:
            try:
                self.diagnostic()
                break
            except (OSError, ValueError, KeyError, SuiteError):
                if self.backend.now() >= deadline:
                    raise SuiteError('queue mode readiness timeout')
                self.backend.sleep(1)

    def begin(self, name):
        self.current = dict(name=name,verdict='PASS',joins=0,startup=0.,mismatch=0.,fallbacks=[],note='')
        self.results.append(self.current)
        self.last_sample = None
        self.mismatch_since = None
        self.due = self.backend.now()
        print('SCENARIO '+name,flush=True)

    def problem(self, reason):
        self.current['verdict'] = 'FAIL'
        raise SuiteError(self.current['name']+': '+reason)

    def sample(self, tracks, *, discontinuity=False, preparing=False):
        started = self.backend.now()
        p = self.diagnostic()
        s = self.speaker.evidence()
        words = self.cli.call(self.mac,'status','-','1','tags:utal')
        status = dict(w.split(':',1) for w in words if ':' in w)
        entries = records(words,'playlist index')
        index = int(status.get('playlist_cur_index','-1'))
        entry = entries[0] if entries else {}
        if not 0 <= index < len(tracks):
            self.problem('LMS index outside scenario')
        expected = tracks[index]
        is_remote=not expected.get('url','').startswith('file://')
        meta = s['metadata']
        title, album = expected_metadata(entry if is_remote else expected,self.title_format if is_remote else "title")
        metadata_matches=meta.get('title')==title and (not album or meta.get('album')==album)
        # Radio text can change while the existing stream path retains startup
        # DIDL. Qualify its source/path and record text; local identity is strict.
        identity = (s['state'] != 'PLAYING' or
                    (entry.get('url')==expected['url'] if is_remote else
                     metadata_matches and entry.get('id')==expected['id']))
        now = self.backend.now()
        row = dict(scenario=self.current['name'],monotonic=now,wall=time.time(),speaker=s,
                   lms=dict(index=index,time=float(status.get('time','0')),title=entry.get('title',''),id=entry.get('id','')),
                   playback=p,identity=identity,metadata_matches=metadata_matches,probe_seconds=now-started,
                   http_requests_per_item=p.get('http_requests_per_item','not exposed'))
        with (self.work/'samples.jsonl').open('a') as f:
            f.write(json.dumps(row,sort_keys=True)+'\n')
        self.samples.append(row)
        if s.get('status','OK')!='OK': self.problem('speaker TransportStatus='+s['status'])
        if p.get('last_fault'): self.problem('relay fault: '+p['last_fault'])
        if p.get('active') != 'queue' or p.get('requested') != 'queue' or p.get('last_fallback') or p.get('latched'):
            self.current['fallbacks'].append(p.get('last_fallback') or p.get('reason'))
            self.problem('fallback '+str(self.current['fallbacks']))
        if s['state']=='PLAYING' and not preparing:
            if is_remote:
                if p.get('path')!='stream' or p.get('reason')!='remote-source' or p.get('owned') or '/music/yeney.flac?' not in s['uri']:
                    self.problem('remote source is not playing on the stream path')
            elif '/music/queue.wav?' not in s['uri'] or not p.get('owned') or p.get('path','relay')!='relay':
                self.problem('speaker is not playing an owned queue item')
            if not is_remote and self.speaker.crossfade() != '0':
                self.problem('Sonos CrossfadeMode not disabled')
            if not identity:
                if self.mismatch_since is None:
                    self.mismatch_since = now
                self.current['mismatch'] = max(self.current['mismatch'],now-self.mismatch_since)
                if now-self.mismatch_since > 2:
                    self.problem('speaker/LMS identity mismatch >2 s')
            else:
                if self.mismatch_since is not None:
                    duration = now-self.mismatch_since
                    self.current['mismatch'] = max(self.current['mismatch'],duration)
                    if duration > 2:
                        self.problem('speaker/LMS identity mismatch >2 s')
                self.mismatch_since = None
            previous = self.last_sample
            if previous and previous['speaker']['state']=='PLAYING':
                old = previous['speaker']
                if old['uri'] != s['uri']:
                    self.current['joins'] += 1
                    with (self.work/'joins.jsonl').open('a') as f:
                        f.write(json.dumps(dict(scenario=self.current['name'],confirmed_monotonic=now,
                            observation_window_s=now-previous['monotonic'],from_uri=old['uri'],to_uri=s['uri'],
                            lms_matches=identity,rel_time=s['rel'],previous_rel_time=old['rel'],
                            continuity_gap_estimate_s=(now-previous['monotonic']-max(0,old['duration']-old['rel'])-s['rel']) if old.get('duration') is not None else None))+'\n')
                elif s['rel'] < old['rel'] and not discontinuity:
                    self.problem('RelTime regressed within item')
        if not preparing:
            self.last_sample = row
        self.due += 1
        self.backend.sleep(max(0,self.due-self.backend.now()))
        return row

    def wait(self, tracks, predicate, timeout, *, discontinuity=False, preparing=False):
        start = self.backend.now()
        while True:
            row = self.sample(tracks,discontinuity=discontinuity,preparing=preparing)
            if row['monotonic']-start > timeout:
                self.problem('evidence deadline exceeded')
            if predicate(row):
                return row, row['monotonic']-start
            if self.backend.now()-start > timeout:
                self.problem('evidence deadline exceeded')

    def load(self, tracks, fade=0, startup_limit=5, require_remote_strm=False):
        self.mutate('stop')
        self.mutate('playlist','shuffle','0'); self.mutate('playlist','repeat','0')
        for k,v in zip(PREFS,('1' if fade else '0','10','0')):
            self.mutate('playerpref',k,v)
            if self.query('playerpref',k)!=v:
                self.problem('LMS transition preference not applied: '+k)
        deadline=self.backend.now()+60
        expected=[dict(id=t['id'],url=t['url']) for t in tracks]
        # cmd:load autoplays. Stage while stopped so the startup clock is
        # anchored to one genuine play, not a redundant later play command.
        self.pending_mutation('playlist','clear')
        if all(t['id'] for t in tracks):
            self.pending_mutation('playlistcontrol','cmd:add','track_id:'+','.join(t['id'] for t in tracks))
        else:
            for track in tracks:self.pending_mutation('playlist','add',track['url'])
        self.lms_ready(expected,'stop',queue=True,deadline=deadline)
        start = self.backend.now()
        play_wall = time.time()
        self.pending_mutation('play')
        if require_remote_strm:self.remote_strm(play_wall,start+5)
        self.lms_ready(expected,'play',queue=True,deadline=deadline)
        self.due=start
        row,_ = self.wait(tracks,lambda r:r['speaker']['state']=='PLAYING' and r['identity'] and
                          ((r['playback'].get('path')=='stream' and '/music/yeney.flac?' in r['speaker']['uri'])
                           if not tracks[0]['url'].startswith('file://') else
                           (r['playback'].get('owned') and '/music/queue.wav?' in r['speaker']['uri'])),max(0,startup_limit-(self.backend.now()-start)),preparing=True)
        delay = row['monotonic']-start
        self.current['startup'] = max(self.current['startup'],delay)
        self.last_sample = row
        if delay > startup_limit:
            self.problem('startup >'+str(startup_limit)+' s')
        self.record_start(row,'play')
        return row

    def record_start(self,row,kind):
        with (self.work/'joins.jsonl').open('a') as f:
            f.write(json.dumps(dict(scenario=self.current['name'],mode=self.ws_mode,kind=kind,
                confirmed_monotonic=row['monotonic'],rel_time=row['speaker']['rel'],uri=row['speaker']['uri'],
                lms_matches=row.get('identity')))+'\n')

    def album(self, name, tracks, fade=0):
        self.begin(name)
        self.load(tracks,fade)
        deadline = sum(float(t['duration']) for t in tracks)+60
        start = self.backend.now()
        while self.current['joins'] < 3:
            row = self.sample(tracks)
            if row['speaker']['state'] == 'STOPPED' or self.backend.now()-start > deadline:
                self.problem('fewer than three joins')
        if self.mismatch_since is not None:
            self.wait(tracks,lambda r:r['identity'],2)

    def measure(self):
        tracks=self.selected['album']
        self.album('album',tracks)
        if getattr(self,'group_members',1)>1:
            self.album('group-coordinator',tracks)
            self.current['note']='owner-formed group; queue path, per-item speaker titles, three joins and LMS identity verified'
        else:
            self.begin('group-coordinator')
            self.current.update(verdict='SKIP',note='selected room is standalone; owner must form a group first')
            print('SKIP group-coordinator: '+self.current['note'],flush=True)
        self.begin('pause-resume')
        self.mutate('pause','1')
        self.wait(tracks,lambda r:r['speaker']['state']=='PAUSED_PLAYBACK',5)
        paused=self.samples[-1]['speaker']['rel']
        until=self.backend.now()+10
        while self.backend.now()<until:
            row=self.sample(tracks)
            if row['speaker']['state']!='PAUSED_PLAYBACK' or row['speaker']['rel']!=paused:
                self.problem('pause did not hold position')
        self.mutate('play')
        self.wait(tracks,lambda r:r['speaker']['state']=='PLAYING' and r['identity'],5)
        self.begin('stop-new-play')
        self.mutate('stop')
        self.wait(tracks,lambda r:r['speaker']['state']=='STOPPED',5)
        self.load(tracks)
        self.begin('external-stop')
        self.speaker.call('AVTransport','Stop',InstanceID=0)
        start=self.backend.now()
        while True:
            row=self.sample(tracks)
            mode=self.cli.call(self.mac,'mode','?')[-1]
            if mode=='stop' and row['playback'].get('state')=='STOPPED' and not row['playback'].get('owned') and not row['playback'].get('owned_item_uris'):
                break
            if self.backend.now()-start>=3:self.problem('speaker Stop not reported to LMS/released within 3 s')
        self.current['note']='direct speaker SOAP Stop -> LMS stop and owned release in '+str(self.backend.now()-start)+' s'
        for name,target in (('high-rate-44100',44100),('high-rate-48000',48000)):
            self.begin(name)
            selected=self.selected[name]
            if not selected:
                self.current.update(verdict='SKIP',note='library has no eligible '+
                                    ('88.2/176.4' if target==44100 else '96/192')+' kHz lossless track >=10 s')
                print('SKIP '+name+': '+self.current['note'],flush=True)
                continue
            row=self.load(selected,startup_limit=3)
            row,_=self.wait(selected,lambda r:r['playback'].get('rendered_rate')==target,3)
            self.current['note']=str(selected[0]['samplerate'])+' -> '+str(target)+' Hz, 24-bit; startup '+str(self.current['startup'])+' s (limit 3 s)'
            until=self.backend.now()+3
            while self.backend.now()<until:self.sample(selected)
        self.remote_scenario()

    def remote_scenario(self):
        candidates=(self.remote_pool or self.selected['remote-source'])[:5]
        self.begin('remote-source')
        rejected=[];selected=None
        for attempt,track in enumerate(candidates,1):
            self.log('remote candidate '+str(attempt)+' '+track['url'])
            with (self.work/'manifest.tsv').open('a',newline='') as f:
                csv.writer(f,delimiter='\t').writerow(['remote-candidate',attempt,track['id'],track.get('title',''),
                    track.get('album',''),track.get('album_id',''),QUEUE['codec'](track),track['samplerate'],track['duration'],track['url']])
            try:
                self.load([track],require_remote_strm=True)
                selected=[track];break
            except RemoteNotStarted as error:
                rejected.append(track['url']+': '+str(error))
                self.log('remote candidate rejected: '+rejected[-1])
                self.mutate('stop');self.pending_mutation('playlist','clear')
        if not selected:
            self.current.update(verdict='SKIP',note='no playable remote candidate: '+self.remote_note+('; '+'; '.join(rejected) if rejected else ''))
            print('SKIP remote-source: '+self.current['note'],flush=True)
            return
        until=self.backend.now()+5
        while self.backend.now()<until:self.sample(selected)
        self.current['note']='remote from '+selected[0].get('remote_menu',self.remote_note)+' started on stream path within 5 s'
        self.begin('local-after-remote')
        self.load(self.selected['album'])
        self.current['note']='local album returned to relay path'

    def restore_item(self,label,expected,setter,getter,compare=None):
        compare=compare or (lambda a,b:a==b)
        got='unavailable'
        for attempt in range(2):
            self.fresh_cli()
            try:
                if attempt:
                    got=getter()
                    if compare(got,expected):return True
                # A lost acknowledgement may still have applied the mutation.
                try:
                    setter()
                except SuiteError as error:
                    self.log('restore mutation uncertain '+label+': '+str(error))
                got=getter()
                if compare(got,expected):return True
            except Exception as error:
                got=str(error)
            self.log('restore retry '+label+' got='+str(got))
        message='NOT RESTORED: '+label+' (expected '+str(expected)+', got '+str(got)+')'
        self.not_restored.append(message);self.errors.append(message);self.log(message)
        return False

    def restore_lms(self):
        entries=self.before['entries']
        # Batch load preserves IDs, order and duplicate occurrences atomically.
        batch_ok=False
        if entries and all(e.get('id') for e in entries):
            try:
                # cmd:load autoplays. A stopped owner gets an ordered add
                # into a verified empty playlist, then a final verified Stop.
                restore_cmd='cmd:load'
                if self.before['mode']=='stop':
                    if not self.restore_item('playlist clear',0,lambda:self.mutate('playlist','clear'),lambda:int(self.query('playlist','tracks'))):
                        raise SuiteError('stopped restore clear unconfirmed')
                    restore_cmd='cmd:add'
                self.pending_mutation('playlistcontrol',restore_cmd,'track_id:'+','.join(e['id'] for e in entries))
                self.lms_ready(entries)
                batch_ok=True
            except Exception as error:
                self.log('batch restore incomplete; recover per entry: '+str(error))
        if not batch_ok:
            cleared=self.restore_item('playlist clear',0,lambda:self.mutate('playlist','clear'),lambda:int(self.query('playlist','tracks')))
            recovered=[]
            for i,entry in enumerate(entries):
                target=recovered+[entry]
                def add(entry=entry,target=target):
                    if self.entries_equal(self.playlist_entries(),target):return
                    if not cleared:raise SuiteError('playlist clear unconfirmed')
                    if entry.get('id'):
                        self.mutate('playlistcontrol','cmd:add','track_id:'+entry['id'])
                    else:
                        self.mutate('playlist','add',entry['url'])
                if self.restore_item('playlist item '+str(i)+' '+(entry.get('id') or entry['url']),target,add,self.playlist_entries,self.entries_equal):
                    recovered=target
        # Every preference is an independent transaction, even if playlist recovery failed.
        for key,args in [('index',('playlist','index')),('time',('time',)),('repeat',('playlist','repeat')),('shuffle',('playlist','shuffle'))]:
            if key in ('index','time') and not entries:continue
            expected=self.before[key]
            compare=(lambda a,b:abs(float(a)-float(b))<=3) if key=='time' else None
            self.restore_item(key,expected,lambda args=args,expected=expected:self.mutate(*args,expected),lambda args=args:self.query(*args),compare)
        for pref in PREFS:
            expected=self.before['prefs'][pref]
            self.restore_item(pref,expected,lambda pref=pref,expected=expected:self.mutate('playerpref',pref,expected),lambda pref=pref:self.query('playerpref',pref))
        if 'volume' in self.before:
            expected=self.before['volume']
            self.restore_item('volume',expected,lambda:self.speaker.set_volume(expected),self.speaker.volume)
        mode=self.before['mode']
        self.restore_item('mode',mode,lambda:self.mutate(*(('pause','1') if mode=='pause' else (mode,))),lambda:self.query('mode'))
        self.restore_item('playlist identities/order',entries,lambda:None,self.playlist_entries,self.entries_equal)

    def cleanup(self):
        self.fresh_cli()
        def attempt(name, fn):
            try:
                fn()
            except Exception as e:
                self.errors.append(name+': '+str(e)); self.log(self.errors[-1])
        if self.playback:
            attempt('stop playback',lambda:self.mutate('stop'))
        if self.override:
            attempt('remove override',lambda:self.dropin.unlink(missing_ok=True))
            def release():
                self.backend.run('systemctl','daemon-reload')
                # Stop verifies release before any saved queue-mode playback can re-arm.
                self.backend.run('systemctl','stop',self.unit)
                self.isolated()
                if self.speaker.crossfade()!=self.before['crossfade']:
                    raise SuiteError('CrossfadeMode not restored')
                if any('/music/queue.wav?' in r.get('res','') for r in self.speaker.browse('Q:0')):
                    raise SuiteError('YeneY-owned entries remain')
                self.release_verified=True
                self.backend.run('systemctl','restart',self.unit)
                self.connected()
            attempt('restore room/release',release)
        if self.playback:
            self.fresh_cli()
            self.restore_lms()
        if self.override:
            def verify():
                self.backend.run('systemctl','is-active','--quiet',self.unit)
                if self.dropin.exists() or self.backend.run('systemctl','show',self.unit,'-p','Environment','--value')!=self.before['environment']:
                    raise SuiteError('room environment not restored')
            attempt('verify service',verify)
        if self.unit:
            attempt('journal',lambda:(self.work/'journal.log').write_text(self.backend.run('journalctl','-u',self.unit,'--since','@'+str(self.started),'--no-pager','-o','short-iso')+'\n'))

    def execute(self):
        watched = (signal.SIGINT,signal.SIGTERM,signal.SIGHUP)
        previous = {s:signal.getsignal(s) for s in watched}
        def interrupted(number, _):
            raise SuiteError('interrupted by signal '+str(number))
        for s in watched:
            signal.signal(s,interrupted)
        try:
            try:
                self.setup()
                self.measure()
            except (Exception,KeyboardInterrupt) as e:
                self.errors.append(str(e) or 'interrupted')
                if self.current:
                    self.current.update(verdict='FAIL',note=str(e))
            finally:
                for s in watched:
                    signal.signal(s,signal.SIG_IGN)
                self.cleanup()
            verdict = 'DEVICE SUITE FAILED: '+'; '.join(dict.fromkeys(self.errors)) if self.errors else 'DEVICE SUITE OK'
            (self.work/'result.txt').write_text(verdict+'\n')
            lines = ['# Queue device qualification','', '| Scenario | Verdict | Joins | Startup/seek max s | Boundary mismatch max s | Fallbacks | Note |', '|---|---|---:|---:|---:|---|---|']
            for name in ('album','pause-resume','stop-new-play','external-stop','high-rate-44100','high-rate-48000'):
                if not any(r['name']==name for r in self.results):
                    self.results.append(dict(name=name,verdict='NOT RUN',joins=0,startup=None,mismatch=0,fallbacks=[],note='prior failure'))
            order={name:i for i,name in enumerate(('album','pause-resume','stop-new-play','external-stop','high-rate-44100','high-rate-48000'))}
            self.results.sort(key=lambda r:order.get(r['name'],len(order)))
            for r in self.results:
                lines.append('| '+' | '.join(str(r[k]).replace('|','/') for k in ('name','verdict','joins','startup','mismatch','fallbacks','note'))+' |')
            lines += ['', *self.not_restored, '', self.backup_note, '', 'Release verified: '+str(self.release_verified), '', CHECKLIST, '', verdict]
            (self.work/'summary.md').write_text('\n'.join(lines)+'\n')
            (self.work/'listening-checklist.txt').write_text(CHECKLIST+'\n')
            self.logfile.close()
            stamp=time.strftime('%Y%m%d-%H%M%S')+'-'+str(os.getpid())+'-'+str(time.time_ns()%1000000000)
            archive=self.output/('yeney-queue-device-suite-'+stamp+'.tar.gz')
            latest=self.output/'yeney-queue-device-suite-latest.tar.gz'
            temporary=None
            try:
                with tarfile.open(archive,'x:gz') as tar:
                    tar.add(self.work,arcname='yeney-queue-device-suite')
                fd,temporary=tempfile.mkstemp(prefix='queue-device-latest-',suffix='.tmp',dir=self.output)
                os.close(fd)
                shutil.copyfile(archive,temporary)
                os.replace(temporary,latest)
            except OSError as error:
                self.errors.append('archive: '+str(error))
                verdict='DEVICE SUITE FAILED: '+'; '.join(dict.fromkeys(self.errors))
                try:
                    (self.work/'result.txt').write_text(verdict+'\n')
                    with (self.work/'summary.md').open('a') as f:f.write('\n'+verdict+'\n')
                except OSError:pass
            finally:
                if temporary and os.path.exists(temporary):os.unlink(temporary)
            print(str(latest)+'\n'+str(archive)+'\n'+'\n'.join(self.not_restored)+'\n'+CHECKLIST+'\n'+verdict,flush=True)
            return 1 if self.errors else 0
        finally:
            for held in reversed(self.locks):
                held.close()
            for s,handler in previous.items():
                signal.signal(s,handler)


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--room',required=True)
    parser.add_argument('--server',required=True)
    parser.add_argument('--remote',help='LMS favourite name, playable remote URL, or podcast episode URL')
    parser.add_argument('--album',help='LMS album ID or exact name; first eligible album by default')
    parser.add_argument('--volume',type=int,default=10,choices=range(101),metavar='0–100')
    args=parser.parse_args()
    suite=Suite(args.room,args.server,album=args.album,volume=args.volume,remote=args.remote)
    if os.geteuid()!=0:
        suite.setup=lambda:(_ for _ in ()).throw(SuiteError('run as root'))
    return suite.execute()


if __name__=='__main__':
    raise SystemExit(main())
